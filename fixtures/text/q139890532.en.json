  "article": {
    "title": "Kokkachal",
    "lead": [
      "<p><b>Kokkachal</b> (<span title=\"Malayalam-language text\"><span lang=\"ml\">കൊക്കച്ചാൽ</span></span>, <span class=\"IPA nowrap\" lang=\"ml-Latn-fonipa\"><a href=\"/wiki/Help:IPA/Malayalam\" title=\"Help:IPA/Malayalam\">&#91;ko̞kːɐt͡ʃːaːl&#93;</a></span>; also spelled <b>Kokkechal</b>) is a small locality and settlement situated in the <a href=\"/wiki/Kasaragod_district\" title=\"Kasaragod district\">Kasaragod district</a> in the Indian state of <a href=\"/wiki/Kerala\" title=\"Kerala\">Kerala</a>. It falls under the administration of the <a href=\"/wiki/Manjeshwaram_taluk\" title=\"Manjeshwaram taluk\">Manjeshwaram taluk</a> near the northern border of the state.</p>"
    ],
