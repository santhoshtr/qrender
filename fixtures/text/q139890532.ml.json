    "concept_sections": {
      "Q1071": [
        "Geography"
      ]
    },
    "section_text": {
      "Geography": "Kokkachal is situated along the rural routes connecting <a href=\"/wiki/Bandiyod\" title=\"Bandiyod\">Bandiyod</a> (approximately 6.5&#160;km away) and Dharmathadukka. Geographically, it sits close to the border of the Puthige and Mangalpady local government jurisdictions. The landscape is characterized by the typical midland topography of Northern Malabar, with seasonal streams feeding into larger coastal river systems.\n"
    }
