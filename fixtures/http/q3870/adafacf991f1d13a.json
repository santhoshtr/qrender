{"parse":{"title":"Nairobi","pageid":21482,"redirects":[],"text":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\" data-mw-parsoid-version=\"0.24.0.0-alpha27\" data-mw-html-version=\"2.8.0\"><section data-mw-section-id=\"0\" id=\"mwAQ\"></section><section data-mw-section-id=\"1\" id=\"mwAg\" aria-labelledby=\"Demographics\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Demographics\">Demographics</h2></div>\n<p id=\"mwAw\">As of 2024, Nairobi has an estimated population of 4.8 million, up from 4.3 million in 2019, making it the largest city in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Kenya\" title=\"Kenya\" id=\"mwBA\">Kenya</a>. The city spans approximately 696 km², with a population density of about 6,900 inhabitants per km². Nairobi's demographics are characterized by a youthful and rapidly growing population, reflecting ongoing urbanization and migration trends.</p>\n\n<span class=\"mw-empty-elt\" about=\"#mwt1\" typeof=\"mw:Transclusion\" id=\"mwBQ\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"historical populations\\n\",\"href\":\"./Template:Historical_populations\"},\"params\":{\"title\":{\"wt\":\"Population of Nairobi between 1906 and 2019\"},\"align\":{\"wt\":\"none\"},\"cols\":{\"wt\":\"3\"},\"graph-pos\":{\"wt\":\"bottom\"},\"1\":{\"wt\":\"1906\"},\"2\":{\"wt\":\"11500\\n\"},\"3\":{\"wt\":\"1911\"},\"4\":{\"wt\":\"14000\\n\"},\"5\":{\"wt\":\"1921\"},\"6\":{\"wt\":\"24300\\n\"},\"7\":{\"wt\":\"1931\"},\"8\":{\"wt\":\"47800\\n\"},\"9\":{\"wt\":\"1939\"},\"10\":{\"wt\":\"61300\\n\"},\"11\":{\"wt\":\"1948\"},\"12\":{\"wt\":\"119000\\n\"},\"13\":{\"wt\":\"1955\"},\"14\":{\"wt\":\"186000\\n\"},\"15\":{\"wt\":\"1960\"},\"16\":{\"wt\":\"251000\\n\"},\"17\":{\"wt\":\"1965\"},\"18\":{\"wt\":\"380000\\n\"},\"19\":{\"wt\":\"1969\"},\"20\":{\"wt\":\"509300\\n\"},\"21\":{\"wt\":\"1979\"},\"22\":{\"wt\":\"827775\\n\"},\"23\":{\"wt\":\"1989\"},\"24\":{\"wt\":\"1324570\\n\"},\"25\":{\"wt\":\"1995\"},\"26\":{\"wt\":\"1810000\\n\"},\"27\":{\"wt\":\"1999\"},\"28\":{\"wt\":\"2143254\\n\"},\"29\":{\"wt\":\"2005\"},\"30\":{\"wt\":\"2750561\\n\"},\"31\":{\"wt\":\"2009\"},\"32\":{\"wt\":\"3138369\\n\"},\"33\":{\"wt\":\"2019\"},\"34\":{\"wt\":\"4397073\\n\"},\"footnote\":{\"wt\":\"Population of Nairobi City&lt;ref>[https://www.knbs.or.ke/?wpdmpro=2019-kenya-population-and-housing-census-volume-i-population-by-county-and-sub-county \\\" 2019 Kenya Population and Housing Census Volume I: Population by County and Sub-County\\\"] {{Webarchive|url=https://web.archive.org/web/20191113191208/https://www.knbs.or.ke/?wpdmpro=2019-kenya-population-and-housing-census-volume-i-population-by-county-and-sub-county |date=13 November 2019 }}, KNBS 2019 Kenya Population and Housing Census.&lt;/ref>\"}},\"i\":0}}]}'><style data-mw-deduplicate=\"TemplateStyles:r1376789456\" typeof=\"mw:Extension/templatestyles\" about=\"#mwt2\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Historical populations/styles.css\"}}'>.mw-parser-output .abbr-header{white-space:nowrap}.mw-parser-output .caption-purple{border:1px var(--border-color-base,#a2a9b1)solid;border-bottom:none;background-color:lavender}@media screen{html.skin-theme-clientpref-night .mw-parser-output .caption-purple{background-color:inherit!important}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .caption-purple{background-color:inherit!important}}.mw-parser-output .table-pale{border:1px var(--border-color-base,#a2a9b1)solid;border-top:none;background-color:var(--background-color-neutral-subtle,#f8f9fa);padding:5px}@media screen and (max-width:640px){.mw-parser-output .table-pale{border-top:1px var(--border-color-base,#a2a9b1)solid!important;float:none!important;margin:auto!important}.mw-parser-output .caption-purple{border:none;display:block}}</style></span><table class=\"table-pale\" role=\"presentation\" style=\"width:45em;border-top-width:0;border-spacing: 0;float:none;clear:none;margin