  "lower-alpha": [
    [
      "cite_note-4",
      {
        "group": "lower-alpha",
        "text": "D.C. stands for <a href=\"https://en.wikipedia.org/wiki/District_of_Columbia\">District of Columbia</a>, the formal name of the U.S. <a href=\"https://en.wikipedia.org/wiki/Federal_district\">federal district</a>."
      }
    ],
    [
      "cite_note-5",
      {
        "group": "lower-alpha",
        "text": "Officially New York but commonly called New York City to avoid confusion with the <a href=\"https://en.wikipedia.org/wiki/New_York_(state)\">state of the same name</a>"
      }
    ],
    [
      "cite_note-officiallanguage-10",
      {
        "group": "lower-alpha",
        "text": "Per <a href=\"https://en.wikipedia.org/wiki/Executive_Order_14224\">Executive Order 14224</a>.<sup data-note=\"cite_note-EOWP-6\"></sup><sup data-note=\"cite_note-EONYT-7\"></sup> States and territories variously recognize English only, English plus one or more local languages, or no language at all. See <a href=\"#Language\">§ Language</a>. The <a href=\"https://en.wikipedia.org/wiki/U.S._Congress\">U.S. Congress</a> has never passed legislation designating an official language at the federal level, and the <a href=\"https://en.wikipedia.org/wiki/U.S._Constitution\">U.S. Constitution</a> does not specify an official language.<sup data-note=\"cite_note-8\"></sup><sup data-note=\"cite_note-9\"></sup>"
      }
    ],
    [
      "cite_note-demonym-16",
      {
        "group": "lower-alpha",
        "text": "The historical and informal demonym <a href=\"https://en.wikipedia.org/wiki/Yankee\">Yankee</a> has been applied to Americans, New Englanders, and northeasterners since the 18th century. Other terms, such as <a href=\"https://en.wikipedia.org/wiki/Usonia_(name)\">Usonian</a>, are rare. For all lesser used terms, see <a href=\"https://en.wikipedia.org/wiki/Demonyms_for_the_United_States\">Demonyms for the United States</a>."
      }
    ],
    [
      "cite_note-largestcountry-20",
      {
        "group": "lower-alpha",
        "text": "At 3,531,900<span> </span>sq<span> </span>mi (9,147,590<span> </span>km<sup>2</sup>), the United States is the third-largest country in the world by land area, behind <a href=\"https://en.wikipedia.org/wiki/Russia\">Russia</a> and <a href=\"https://en.wikipedia.org/wiki/China\">China</a>. By total area (land and water), it is the third-largest, behind Russia and <a href=\"https://en.wikipedia.org/wiki/Canada\">Canada</a>, if its coastal and territorial water areas are included. However, if only its internal waters are included (bays, sounds, rivers, lakes, and the <a href=\"https://en.wikipedia.org/wiki/Great_Lakes\">Great Lakes</a>), the U.S. ranks fourth, after Russia, Canada, and China.\n<br>\nCoastal/territorial waters included: 3,796,742<span> </span>sq<span> </span>mi (9,833,517<span> </span>km<sup>2</sup>)<sup data-note=\"cite_note-CIA_Factbook_Area-18\"></sup>\n<br>\nOnly internal waters included: 3,696,100<span> </span>sq<span> </span>mi (9,572,900<span> </span>km<sup>2</sup>)<sup data-note=\"cite_note-BritannicaUS-19\"></sup>"
      }
    ],
    [
      "cite_note-pop-24",
      {
        "group": "lower-alpha",
        "text": "This figure excludes <a href=\"https://en.wikipedia.org/wiki/Puerto_Rico\">Puerto Rico</a> and the other <a href=\"https://en.wikipedia.org/wiki/Unincorporated_territories_of_the_United_States\">unincorporated islands</a> because they are counted separately in <a href=\"https://en.wikipedia.org/wiki/U.S._census\">U.S. census</a> statistics."
      }
    ],
    [
      "cite_note-PPP-26",
      {
        "group": "lower-alpha",
        "text": "U.S. nominal and PPP-adjusted GDP are the same as the U.S. is the reference country for PPP calculations."
      }
    ],
    [
      "cite_note-28",
      {
        "group": "lower-alpha",
        "text": "After adjustment for taxes and transfers"
      }
    ],
    [
      "cite_note-time-30",
      {
        "group": "lower-alpha",
        "text": "See <a href=\"https://en.wikipedia.org/wiki/Time_in_the_United_States\">Time in the United States</a> for details about laws governing time zones in the United States."
      }
    ],
    [
      "cite_note-31",
      {
        "group": "lower-alpha",
        "text": "See <a href=\"https://en.wikipedia.org/wiki/Date_and_time_notation_in_the_United_States\">Date and time notation in the United States</a>."
      }
    ]
  ],
