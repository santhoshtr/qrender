            <section class="spread t-columns" id="demography"
             data-spread="demography"
             data-dimension="measures"><h2><span class="title">demography</span></h2><div data-slot="stack">
        <qr-chart class="block series"><h3>population
    <button class="info"
            type="button"
            popovertarget="p56"
            aria-label="Description">i</button><span id="p56" popover class="pop">number of people inhabiting the place; number of people of subject</span>
    <a class="edit"
       href="https://www.wikidata.org/wiki/Q668#P1082"
       aria-label="Edit"><svg aria-hidden="true" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"><path d="m15.4.4 4.2 4.2-3.2 3.2-4.2-4.2zM10.8 5 15 9.2l-8.6 8.6-4.5 1.5-1.2-1.2 1.5-4.5z"/></svg></a>
    </h3>
<div class="chart">
    <div class="data">
        <table>
            <thead>
                <tr>
                    <th scope="col">point in time</th>
                        <th scope="col">population</th>
