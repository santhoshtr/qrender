            <section class="spread t-identity"
             data-spread="identity" data-dimension="neutral"><div data-slot="head">
        <div class="title"><h1>India</h1>
        <p>
            country in South Asia
        </p>
    </div>
</div><div data-slot="band">
        <div class="band"> <figure class="m k-photo" style="--a:6.9825">
        <a href="https://commons.wikimedia.org/wiki/File:TajMahal_Banner.jpg">
            <img src="https://commons.wikimedia.org/wiki/Special:FilePath/TajMahal%20Banner.jpg?width=960"
