                <p class="prose-links"><a href="https://ml.wikipedia.org/wiki/%E0%B4%95%E0%B5%8A%E0%B4%95%E0%B5%8D%E0%B4%95%E0%B4%9A%E0%B5%8D%E0%B4%9A%E0%B4%BE%E0%B5%BD#വിദ്യാഭ്യാസവും_സ്ഥാപനങ്ങളും">വിദ്യാഭ്യാസവും സ്ഥാപനങ്ങളും</a> · <a href="https://ml.wikipedia.org/wiki/%E0%B4%95%E0%B5%8A%E0%B4%95%E0%B5%8D%E0%B4%95%E0%B4%9A%E0%B5%8D%E0%B4%9A%E0%B4%BE%E0%B5%BD#ഗതാഗതം">ഗതാഗതം</a> · <a href="https://ml.wikipedia.org/wiki/%E0%B4%95%E0%B5%8A%E0%B4%95%E0%B5%8D%E0%B4%95%E0%B4%9A%E0%B5%8D%E0%B4%9A%E0%B4%BE%E0%B5%BD#ഇതും_കാണുക">ഇതും കാണുക</a> · <a href="https://ml.wikipedia.org/wiki/%E0%B4%95%E0%B5%8A%E0%B4%95%E0%B5%8D%E0%B4%95%E0%B4%9A%E0%B5%8D%E0%B4%9A%E0%B4%BE%E0%B5%BD#പരാമർശങ്ങൾ">പരാമർശങ്ങൾ</a></p>
            </section>
        <p class="provenance-note">Composed by rule from Wikidata item <a href="https://www.wikidata.org/wiki/Q139890532">Q139890532</a> (composition/0.3, view/0.2, design/0.2). The lead paragraph, the section paragraphs and the section links come from Wikipedia. Pictures come from Wikimedia Commons; a W on a picture marks one from an article, not from Wikidata; a W on a value marks a statement whose only reference is a Wikipedia.</p>
    </main>
    <script>// Progressive enhancement only: opens and closes dialogs in browsers
// without the invoker commands API. The content does not need it.
if ( !( 'commandForElement' in HTMLButtonElement.prototype ) ) {
	document.addEventListener( 'click', ( event ) => {
		const button = event.target.closest( 'button[commandfor]' );
		if ( !button ) {
			return;
		}
		const target = document.getElementById( button.getAttribute( 'commandfor' ) );
		if ( !target ) {
			return;
		}
		if ( button.getAttribute( 'command' ) === 'close' ) {
			target.close();
		} else {
			target.showModal();
		}
	} );
}
// Progressive enhancement only: numbers and dates in the formats of the
// page locale, by the browser's Intl. The server writes a neutral text
// (digits without grouping, ISO dates); without this script it stays,
// correct but not localized.
( () => {
	const locale = document.documentElement.dataset.locale || document.documentElement.lang;
	let number, percent;
	try {
		number = new Intl.NumberFormat( locale, { maximumFractionDigits: 20 } );
		percent = new Intl.NumberFormat( locale, { style: 'percent', maximumSignificantDigits: 2 } );
	} catch ( e ) {
		return;
	}
	for ( const el of document.querySelectorAll( 'data[data-f]' ) ) {
		const value = Number( el.value );
		if ( Number.isNaN( value ) ) {
			continue;
		}
		if ( el.dataset.f === 'number' ) {
			el.textContent = number.format( value );
		} else if ( el.dataset.f === 'percent' ) {
			el.textContent = percent.format( value );
		}
		// "scientific" keeps its neutral text: m × 10ⁿ.
	}
	// Wikidata precision: 9 year, 10 month, 11 day.
	const options = {
		9: { year: 'numeric' },
		10: { year: 'numeric', month: 'long' },
		11: { year: 'numeric', month: 'long', day: 'numeric' }
	};
	for ( const el of document.querySelectorAll( 'time[datetime][data-p]' ) ) {
		const [ year, month = 1, day = 1 ] = el.dateTime.split( '-' ).map( Number );
		const date = new Date( Date.UTC( 2000, month - 1, day ) );
		date.setUTCFullYear( year ); // Date.UTC reads years below 100 as 19xx
		try {
			el.textContent = new Intl.DateTimeFormat( locale,
				{ ...options[ Math.min( Number( el.dataset.p ), 11 ) ], timeZone: 'UTC' } ).format( date );
		} catch ( e ) {
			// The neutral text stays.
		}
	}
} )();
</script>
