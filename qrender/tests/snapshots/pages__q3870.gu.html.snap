            data-dir="ltr"><div class="head"><h3>Twin towns and sister cities</h3><button class="translate" type="button" lang="gu" hidden><svg aria-hidden="true" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20">
	
