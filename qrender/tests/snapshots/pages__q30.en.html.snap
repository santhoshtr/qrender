    <span class="head"><img class="favicon" src="https://favicons.toolforge.org/favicon?url=www.iso.org" alt="" width="32" height="32" loading="lazy"><span class="title"><a href="https://www.iso.org/obp/ui/#iso:code:3166:US" lang="en">ISO 3166-1</a></span><span class="host">iso.org</span></span>
