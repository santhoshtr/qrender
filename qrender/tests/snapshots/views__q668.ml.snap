    {
      "id": "history",
      "prose_links": [
        {
          "href": "https://ml.wikipedia.org/wiki/%E0%B4%87%E0%B4%A8%E0%B5%8D%E0%B4%A4%E0%B5%8D%E0%B4%AF#ചരിത്രം",
          "lang": "ml",
          "text": "ചരിത്രം"
        }
      ],
      "prose_text": {
        "href": "https://ml.wikipedia.org/wiki/%E0%B4%87%E0%B4%A8%E0%B5%8D%E0%B4%A4%E0%B5%8D%E0%B4%AF#ചരിത്രം",
        "html": "ചരിത്രാതീത യൂറോപ്പിന്റേതുപോലെ തന്നെ ഉത്തരേന്ത്യയിലും <a href=\"https://ml.wikipedia.org/wiki/%E0%B4%B9%E0%B4%BF%E0%B4%AE%E0%B4%AF%E0%B5%81%E0%B4%97%E0%B4%82\">ഹിമയുഗം</a> ഉണ്ടായിട്ടുണ്ട്. ഹിമയുഗത്തിലെ രണ്ടാം പാദത്തിലെ 4,00,000 നും 2,00,000 നുമിടക്കുള്ള വർഷങ്ങളിലാണു മനുഷ്യന്റെ പാദസ്പർശം ഈ ഭൂമിയിൽ ഉണ്ടായത്. ഇതിന്റെ തെളിവ് പഞ്ചാബിലെ സോഹൻ നദിയുടെ തീരത്തുയർന്ന നാഗരികതയുടെ അവശിഷ്ടങ്ങളിൽ നിന്നാണു ലഭിച്ചത്. വെള്ളാരം കല്ലുകൾ കൊണ്ടുള്ള ആയുധങ്ങൾ ഈ നദിയുടെ തീരങ്ങളിൽ നിന്ന് ലഭിക്കുകയുണ്ടായി. ഇവയ്ക്കൊപ്പം ശരീരാവശിഷ്ടങ്ങൾ കണ്ടെടുക്കാനായിട്ടില്ല.",
        "lang": "ml",
        "local": true,
        "title": "ചരിത്രം"
      },
      "title": {
        "href": "https://www.wikidata.org/wiki/Q309",
        "lang": "ml",
        "text": "ചരിത്രം"
      }
