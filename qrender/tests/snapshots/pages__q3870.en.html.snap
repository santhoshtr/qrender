    <script>// Progressive enhancement only: opens and closes dialogs in browsers
// without the invoker commands API. The content does not need it.
if ( !( 'commandForElement' in HTMLButtonElement.prototype ) ) {
	document.addEventListener( 'click', ( event ) => {
		const button = event.target.closest( 'button[commandfor]' );
		if ( !button ) {
			return;
		}
		const target = document.getElementById( button.getAttribute( 'commandfor' ) );
		if ( !target ) {
			return;
		}
		if ( button.getAttribute( 'command' ) === 'close' ) {
			target.close();
		} else {
			target.showModal();
		}
	} );
}
// Progressive enhancement only: numbers, dates and language names in the
// formats of the page locale, by the browser's Intl. The server writes a neutral text
// (digits without grouping, ISO dates); without this script it stays,
// correct but not localized.
( () => {
	const locale = document.documentElement.dataset.locale || document.documentElement.lang;
	// The name of a language in the page locale, for its code
	// (data-lang-name). A code that the browser does not know stays.
	try {
		const languages = new Intl.DisplayNames( locale, { type: 'language', fallback: 'none' } );
		for ( const el of document.querySelectorAll( '[data-lang-name]' ) ) {
			try {
				const name = languages.of( el.dataset.langName );
				if ( name ) {
					el.textContent = name;
				}
			} catch ( e ) {
				// Not a language code: the code stays.
			}
		}
	} catch ( e ) {
		// No Intl.DisplayNames: the codes stay.
	}
	let number, percent;
	try {
		number = new Intl.NumberFormat( locale, { maximumFractionDigits: 20 } );
		percent = new Intl.NumberFormat( locale, { style: 'percent', maximumSignificantDigits: 2 } );
	} catch ( e ) {
		return;
	}
	for ( const el of document.querySelectorAll( 'data[data-f]' ) ) {
		const value = Number( el.value );
		if ( Number.isNaN( value ) ) {
			continue;
		}
		if ( el.dataset.f === 'number' ) {
			el.textContent = number.format( value );
		} else if ( el.dataset.f === 'percent' ) {
			el.textContent = percent.format( value );
		}
		// "scientific" keeps its neutral text: m × 10ⁿ.
	}
	// Wikidata precision: 9 year, 10 month, 11 day.
	const options = {
		9: { year: 'numeric' },
		10: { year: 'numeric', month: 'long' },
		11: { year: 'numeric', month: 'long', day: 'numeric' }
	};
	for ( const el of document.querySelectorAll( 'time[datetime][data-p]' ) ) {
		const [ year, month = 1, day = 1 ] = el.dateTime.split( '-' ).map( Number );
		const date = new Date( Date.UTC( 2000, month - 1, day ) );
		date.setUTCFullYear( year ); // Date.UTC reads years below 100 as 19xx
		try {
			el.textContent = new Intl.DateTimeFormat( locale,
				{ ...options[ Math.min( Number( el.dataset.p ), 11 ) ], timeZone: 'UTC' } ).format( date );
		} catch ( e ) {
			// The neutral text stays.
		}
	}
} )();
// Progressive enhancement only: a play link (a.play) of an audio file
// plays the file in the page; a second click stops it. One sound plays at
// a time. Without this script the link opens the file, and the browser
// plays it.
( () => {
	let sound, link;
	const stop = () => {
		sound.pause();
		link.classList.remove( 'playing' );
		sound = link = null;
	};
	document.addEventListener( 'click', ( event ) => {
		const a = event.target.closest( 'a.play' );
		if ( !a ) {
			return;
		}
		event.preventDefault();
		const again = link === a;
		if ( sound ) {
			stop();
		}
		if ( again ) {
			return;
		}
		sound = new Audio( a.href );
		link = a;
		a.classList.add( 'playing' );
		sound.addEventListener( 'ended', () => link === a && stop() );
		sound.play().catch( () => {
			window.location.href = a.href;
		} );
	} );
} )();
// Progressive enhancement only: a video plays in its dialog. It starts when
// the dialog opens (the reader asked for it with the play button), and it
// stops when the dialog closes. Without this script, the reader starts it
// with its controls, and it plays on after the dialog closes.
// The toggle and close events of a dialog do not bubble: they are heard in
// the capture phase.
document.addEventListener( 'toggle', ( event ) => {
	if ( event.newState === 'open' && event.target.matches( 'dialog.lightbox' ) ) {
		// A browser can refuse to play; the controls are there.
		event.target.querySelector( 'video' )?.play().catch( () => {} );
	}
}, true );

document.addEventListener( 'close', ( event ) => {
	event.target.querySelector( 'video' )?.pause();
}, true );
// The qr-model element: a 3D model (a binary STL file) that the reader turns
// (drag) and zooms (wheel), drawn by WebGL2 with no library. Progressive
// enhancement only: the element holds the picture that Commons renders from
// the file, and without WebGL2 or this script the picture stays. The file is
// large (tens of MB), so it loads only when the dialog of the element opens,
// and a close stops the load. A model that is loaded stays.
// One function scope: the page scripts share one script element.
( () => {
	if ( !( 'customElements' in window ) ) {
		return;
	}

	const percent = new Intl.NumberFormat( document.documentElement.lang, { style: 'percent' } );

	customElements.define( 'qr-model', class extends HTMLElement {
		connectedCallback() {
			this.dialog = this.closest( 'dialog' );
			this.dialog?.addEventListener( 'toggle', ( event ) => {
				if ( event.newState === 'open' ) {
					this.open();
				} else {
					this.controller?.abort();
				}
			} );
		}

		async open() {
			if ( this.controller || this.done ) {
				return;
			}
			const canvas = document.createElement( 'canvas' );
			const gl = canvas.getContext( 'webgl2' );
			if ( !gl ) {
				return;
			}
			const status = this.querySelector( '.status' );
			const total = Number( this.dataset.bytes );
			const progress = ( received ) => {
				status.textContent = this.dataset.loading.replace( '$1', total ? percent.format( received / total ) : '' );
			};
			this.controller = new AbortController();
			progress( 0 );
			try {
				const buffer = await load( this.getAttribute( 'src' ), this.controller.signal, progress );
				const mesh = parse( buffer );
				status.textContent = mesh ? '' : this.dataset.unsupported;
				if ( mesh ) {
					draw( this, canvas, gl, mesh );
				}
				this.done = true;
			} catch {
				// Stopped or failed: the picture stays, and the next open tries again.
				status.textContent = '';
			} finally {
				this.controller = null;
			}
		}
	} );

	async function load( url, signal, progress ) {
		const response = await fetch( url, { signal } );
		if ( !response.ok ) {
			throw new Error( response.status );
		}
		const reader = response.body.getReader();
		const chunks = [];
		let received = 0;
		for ( ;; ) {
			const { done, value } = await reader.read();
			if ( done ) {
				break;
			}
			chunks.push( value );
			received += value.length;
			progress( received );
		}
		const buffer = new Uint8Array( received );
		let offset = 0;
		for ( const chunk of chunks ) {
			buffer.set( chunk, offset );
			offset += chunk.length;
		}
		return buffer.buffer;
	}

	// Binary STL: an 80-byte header, a triangle count, then 50 bytes a triangle.
	// A file of another size is not binary STL (an ASCII STL): null. Normals
	// come from the vertices; the stored ones are often empty.
	function parse( buffer ) {
		const view = new DataView( buffer );
		const count = buffer.byteLength >= 84 ? view.getUint32( 80, true ) : 0;
		if ( !count || buffer.byteLength !== 84 + count * 50 ) {
			return null;
		}
		const position = new Float32Array( count * 9 );
		const normal = new Float32Array( count * 9 );
		const min = [ Infinity, Infinity, Infinity ], max = [ -Infinity, -Infinity, -Infinity ];
		for ( let i = 0; i < count; i++ ) {
			const base = 84 + i * 50 + 12;
			for ( let j = 0; j < 9; j++ ) {
				const v = view.getFloat32( base + j * 4, true );
				position[ i * 9 + j ] = v;
				min[ j % 3 ] = Math.min( min[ j % 3 ], v );
				max[ j % 3 ] = Math.max( max[ j % 3 ], v );
			}
			const p = position.subarray( i * 9, i * 9 + 9 );
			const ux = p[ 3 ] - p[ 0 ], uy = p[ 4 ] - p[ 1 ], uz = p[ 5 ] - p[ 2 ];
			const vx = p[ 6 ] - p[ 0 ], vy = p[ 7 ] - p[ 1 ], vz = p[ 8 ] - p[ 2 ];
			let nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx;
			const length = Math.hypot( nx, ny, nz ) || 1;
			nx /= length; ny /= length; nz /= length;
			for ( let k = 0; k < 3; k++ ) {
				normal[ i * 9 + k * 3 ] = nx; normal[ i * 9 + k * 3 + 1 ] = ny; normal[ i * 9 + k * 3 + 2 ] = nz;
			}
		}
		const centre = [ 0, 1, 2 ].map( ( k ) => ( min[ k ] + max[ k ] ) / 2 );
		const size = Math.max( max[ 0 ] - min[ 0 ], max[ 1 ] - min[ 1 ], max[ 2 ] - min[ 2 ] );
		return { position, normal, count: count * 3, centre, size };
	}

	// The mesh, grey and lit from the upper left, on a transparent canvas (the
	// stage of the dialog gives the background). It turns slowly until the
	// reader drags it, and not at all with reduced motion. It is drawn only
	// while its dialog is open.
	function draw( element, canvas, gl, mesh ) {
		const program = gl.createProgram();
		[ [ gl.VERTEX_SHADER, `#version 300 es
			in vec3 position; in vec3 normal;
			uniform mat4 model; uniform mat4 projection;
			out vec3 vNormal;
			void main() {
				vNormal = mat3( model ) * normal;
				gl_Position = projection * model * vec4( position, 1.0 );
			}` ], [ gl.FRAGMENT_SHADER, `#version 300 es
			precision mediump float;
			in vec3 vNormal; out vec4 colour;
			void main() {
				float light = max( dot( normalize( vNormal ), normalize( vec3( -0.5, 0.6, 0.8 ) ) ), 0.0 );
				colour = vec4( vec3( 0.12 + 0.82 * light ), 1.0 );
			}` ] ].forEach( ( [ type, source ] ) => {
			const shader = gl.createShader( type );
			gl.shaderSource( shader, source );
			gl.compileShader( shader );
			gl.attachShader( program, shader );
		} );
		gl.linkProgram( program );
		gl.useProgram( program );
		[ [ 'position', mesh.position ], [ 'normal', mesh.normal ] ].forEach( ( [ name, data ] ) => {
			gl.bindBuffer( gl.ARRAY_BUFFER, gl.createBuffer() );
			gl.bufferData( gl.ARRAY_BUFFER, data, gl.STATIC_DRAW );
			const location = gl.getAttribLocation( program, name );
			gl.enableVertexAttribArray( location );
			gl.vertexAttribPointer( location, 3, gl.FLOAT, false, 0, 0 );
		} );
		gl.enable( gl.DEPTH_TEST );
		gl.enable( gl.CULL_FACE );
		gl.clearColor( 0, 0, 0, 0 );
		const modelAt = gl.getUniformLocation( program, 'model' );
		const projectionAt = gl.getUniformLocation( program, 'projection' );
		const count = mesh.count, s = 2 / mesh.size, [ cx, cy, cz ] = mesh.centre;

		const still = matchMedia( '(prefers-reduced-motion: reduce)' ).matches;
		let yaw = 0, pitch = 0.3, distance = 3.4, dragging = null, spinning = !still, pending = 0;

		function frame() {
			pending = 0;
			if ( !element.dialog.open ) {
				return;
			}
			const w = canvas.clientWidth * devicePixelRatio, h = canvas.clientHeight * devicePixelRatio;
			if ( canvas.width !== w || canvas.height !== h ) {
				canvas.width = w;
				canvas.height = h;
			}
			gl.viewport( 0, 0, w, h );
			gl.clear( gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT );
			if ( spinning ) {
				yaw += 0.003;
			}
			const cyw = Math.cos( yaw ), syw = Math.sin( yaw ), cp = Math.cos( pitch ), sp = Math.sin( pitch );
			// model = translate(0,0,-distance) * rotateX(pitch) * rotateY(yaw) * scale * translate(-centre)
			const r = [ cyw, sp * syw, -cp * syw, 0, 0, cp, sp, 0, syw, -sp * cyw, cp * cyw, 0 ];
			const model = new Float32Array( 16 );
			for ( let c = 0; c < 3; c++ ) {
				for ( let k = 0; k < 3; k++ ) {
					model[ c * 4 + k ] = r[ c * 4 + k ] * s;
				}
			}
			for ( let k = 0; k < 3; k++ ) {
				model[ 12 + k ] = -( r[ k ] * cx + r[ 4 + k ] * cy + r[ 8 + k ] * cz ) * s;
			}
			model[ 14 ] -= distance;
			model[ 15 ] = 1;
			const f = 1 / Math.tan( 0.4 ), near = 0.1, far = 20, aspect = w / h;
			const projection = new Float32Array( [ f / aspect, 0, 0, 0, 0, f, 0, 0, 0, 0, ( far + near ) / ( near - far ), -1, 0, 0, 2 * far * near / ( near - far ), 0 ] );
			gl.uniformMatrix4fv( modelAt, false, model );
			gl.uniformMatrix4fv( projectionAt, false, projection );
			gl.drawArrays( gl.TRIANGLES, 0, count );
			run();
		}
		const run = () => {
			pending ||= requestAnimationFrame( frame );
		};

		canvas.addEventListener( 'pointerdown', ( event ) => {
			dragging = [ event.clientX, event.clientY ];
			spinning = false;
			canvas.setPointerCapture( event.pointerId );
		} );
		canvas.addEventListener( 'pointermove', ( event ) => {
			if ( !dragging ) {
				return;
			}
			yaw += ( event.clientX - dragging[ 0 ] ) * 0.01;
			pitch = Math.max( -1.5, Math.min( 1.5, pitch + ( event.clientY - dragging[ 1 ] ) * 0.01 ) );
			dragging = [ event.clientX, event.clientY ];
		} );
		canvas.addEventListener( 'pointerup', () => {
			dragging = null;
		} );
		canvas.addEventListener( 'wheel', ( event ) => {
			event.preventDefault();
			distance = Math.max( 1.2, Math.min( 6, distance * ( 1 + event.deltaY * 0.001 ) ) );
		}, { passive: false } );
		element.dialog.addEventListener( 'toggle', ( event ) => {
			if ( event.newState === 'open' ) {
				run();
			}
		} );

		canvas.setAttribute( 'role', 'img' );
		canvas.setAttribute( 'aria-label', element.dataset.label );
		element.querySelector( 'img' ).replaceWith( canvas );
		run();
	}
} )();
// The qr-map element: the map of a dialog, which the reader moves and
// zooms, drawn by Leaflet with the tiles of Wikimedia maps in the page
// language. Progressive enhancement only: the element holds the static map
// of the page, and without this script or without Leaflet it stays. The
// server gives the data (the pin, the box to show first, the markers, the
// outlines); the script draws it, and CSS gives the colours by the class
// names. Leaflet loads once, when the first map dialog opens: a map needs
// the size of its box, and a closed dialog has none.
// One function scope: the page scripts share one script element.
( () => {
	const root = document.documentElement;
	// The design base is on a page that the server sends (not in a file).
	const base = root.dataset.design;
	if ( !base || !( 'customElements' in window ) ) {
		return;
	}
	const tiles = `https://maps.wikimedia.org/osm-intl/{z}/{x}/{y}{r}.png?lang=${ encodeURIComponent( root.lang ) }`;
	const load = ( element ) => new Promise( ( resolve, reject ) => {
		element.onload = resolve;
		element.onerror = reject;
		document.head.append( element );
	} );
	let loading;
	const leaflet = () => loading ??= Promise.all( [
		load( Object.assign( document.createElement( 'link' ), { rel: 'stylesheet', href: `${ base }/leaflet.css` } ) ),
		load( Object.assign( document.createElement( 'script' ), { src: `${ base }/leaflet.js` } ) )
	] ).then( () => window.L );

	customElements.define( 'qr-map', class extends HTMLElement {
		connectedCallback() {
			this.dialog = this.closest( 'dialog' );
			this.dialog?.addEventListener( 'toggle', ( event ) => {
				if ( event.newState === 'open' ) {
					this.open();
				}
			} );
		}

		async open() {
			if ( this.map ) {
				// The window can have changed since the last open.
				this.map.invalidateSize();
				return;
			}
			const L = await leaflet().catch( () => null );
			// The dialog can have closed while Leaflet loaded: the next open draws.
			if ( !L || this.map || !this.dialog.open ) {
				return;
			}
			const data = JSON.parse( this.dataset.map );
			const icon = ( className ) => L.divIcon( { className, iconSize: null } );
			const attribution = Object.assign( document.createElement( 'a' ), {
				href: 'https://www.openstreetmap.org/copyright',
				textContent: this.dataset.attribution
			} ).outerHTML;

			this.replaceChildren();
			const map = this.map = L.map( this );
			map.attributionControl.setPrefix( false );
			map.fitBounds( data.bounds );
			L.tileLayer( tiles, { maxZoom: 18, attribution } ).addTo( map );
			for ( const outline of data.outlines ) {
				const className = outline.main ? 'main' : 'other';
				if ( outline.rings.length ) {
					L.polygon( outline.rings, { className, interactive: false } ).addTo( map );
				}
				if ( outline.lines.length ) {
					L.polyline( outline.lines, { className: `${ className } open`, interactive: false } ).addTo( map );
				}
			}
			for ( const marker of data.markers ) {
				L.marker( marker.at, { icon: icon( 'marker' ), title: marker.label, keyboard: false } ).addTo( map );
			}
			L.marker( data.pin, { icon: icon( 'pin' ), interactive: false, keyboard: false } ).addTo( map );
		}
	} );
} )();
// The qr-section element: a text of the article in another language (the
// page language has no article), which the reader translates into the page
// language. Progressive enhancement only: the server renders the text, and
// every word of the editor in the dialog of the page (#translator); without
// this script the text stays and the button stays hidden. On "Translate",
// the dialog opens: each block of the text (its title, a paragraph, a list,
// the title of a subsection) goes to the machine translation of Wikimedia
// (MinT, by cxserver), a few at a time, and its translation comes in an
// editable row beside it. "Save" mimics a published edit: the section on
// the page shows the translation. Nothing is sent.
// One function scope: the page scripts share one script element.
( () => {
	const dialog = document.getElementById( 'translator' );
	if ( !dialog || !( 'customElements' in window ) ) {
		return;
	}
	const MT = 'https://cxserver.wikimedia.org/v2/translate';
	// Requests at a time: MinT takes about 1.5 s for a paragraph.
	const PARALLEL = 4;
	const BLOCKS = 'p, ul, ol, dl, blockquote';
	// What a translation may hold: the tags of the text, links to the web.
	const ALLOWED = new Set( [ 'P', 'UL', 'OL', 'LI', 'DL', 'DT', 'DD', 'BLOCKQUOTE',
		'H2', 'H3', 'H4', 'H5', 'H6', 'A', 'B', 'I', 'SPAN' ] );
	const rows = dialog.querySelector( '.rows' );
	const status = dialog.querySelector( '.status' );
	// The section in the dialog, and the requests of its translation.
	let current = null;
	let controller = null;

	// The blocks of a text, in order: a subsection gives its title, then
	// its blocks.
	const units = ( container ) => [ ...container.children ].flatMap( ( el ) => {
		if ( el.matches( BLOCKS ) ) {
			return [ el ];
		}
		if ( el.matches( 'details' ) ) {
			return [ el.querySelector( ':scope > summary > :is( h3, h4, h5, h6 )' ), ...units( el ) ];
		}
		return [];
	} );

	// A block without the glosses of its links (the labels in the page
	// language) and the marks of its notes: the machine translation reads
	// the source text only.
	const source = ( el ) => {
		const copy = el.cloneNode( true );
		copy.querySelectorAll( 'sup.ref' ).forEach( ( mark ) => mark.remove() );
		copy.querySelectorAll( 'rt' ).forEach( ( rt ) => rt.remove() );
		copy.querySelectorAll( 'ruby' ).forEach( ( ruby ) => ruby.replaceWith( ...ruby.childNodes ) );
		return copy;
	};

	// Untrusted HTML of the service, cleaned: an element that is not
	// allowed leaves its text; no attribute but an http(s) link.
	const clean = ( html ) => {
		const template = document.createElement( 'template' );
		template.innerHTML = html;
		const walk = ( node ) => {
			for ( const child of [ ...node.children ] ) {
				walk( child );
				if ( !ALLOWED.has( child.tagName ) ) {
					child.replaceWith( ...child.childNodes );
					continue;
				}
				for ( const { name, value } of [ ...child.attributes ] ) {
					if ( !( name === 'href' && /^https?:\/\//.test( value ) ) ) {
						child.removeAttribute( name );
					}
				}
			}
		};
		walk( template.content );
		return template.content;
	};

	const translate = async ( from, to, el, signal ) => {
		// MinT translates the first element only: one block in a section.
		const response = await fetch( `${ MT }/${ from }/${ to }/MinT`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify( { html: `<section>${ el.outerHTML }</section>` } ),
			signal
		} );
		if ( !response.ok ) {
			throw new Error( response.status );
		}
		const { contents } = await response.json();
		const fragment = clean( contents );
		if ( !fragment.textContent.trim() ) {
			throw new Error( 'empty' );
		}
		return fragment;
	};

	// The jobs, `n` at a time.
	const run = async ( jobs, n ) => {
		let next = 0;
		await Promise.all( Array.from( { length: n }, async () => {
			while ( next < jobs.length ) {
				await jobs[ next++ ]();
			}
		} ) );
	};

	// The content of a translated row: the children of its block when it
	// is of the same kind as the source (a paragraph for a paragraph).
	const content = ( target, unit ) => {
		const el = target.firstElementChild;
		return el && el.tagName === unit.tagName && target.children.length === 1 ?
			[ ...el.childNodes ] : [ ...target.childNodes ];
	};

	dialog.addEventListener( 'close', () => {
		controller?.abort();
		current = null;
		rows.replaceChildren();
		status.textContent = '';
	} );
	dialog.querySelector( '.discard' ).addEventListener( 'click', () => dialog.close() );
	dialog.querySelector( '.save' ).addEventListener( 'click', () => {
		current?.save( [ ...rows.querySelectorAll( '.translated' ) ] );
		dialog.close();
	} );

	customElements.define( 'qr-section', class extends HTMLElement {
		connectedCallback() {
			// The section's own button and text, not those of a section in it.
			this.button = this.querySelector( '.translate' );
			this.heading = this.querySelector( ':scope > .head > :is( h2, h3, h4, h5, h6 )' );
			this.body = this.querySelector( ':scope > .body' );
			if ( !this.button || !this.body ) {
				return;
			}
			this.button.hidden = false;
			this.button.addEventListener( 'click', () => this.open() );
		}

		// The blocks on the page: the title first, then the text.
		units() {
			return [ ...( this.heading ? [ this.heading ] : [] ), ...units( this.body ) ];
		}

		async open() {
			if ( dialog.open ) {
				return;
			}
			const { from, to, dir } = this.dataset;
			// The English blocks of the first open: after a save, the page
			// shows the translation.
			this.sources ??= this.units().map( source );
			current = this;
			controller = new AbortController();
			const { signal } = controller;
			dialog.querySelector( '.section-title' ).textContent =
				this.heading ? ` · ${ this.sources[ 0 ].textContent }` : '';
			const jobs = this.sources.map( ( block, i ) => {
				const target = document.createElement( 'div' );
				target.className = 'translated';
				target.lang = to;
				target.dir = dir;
				target.contentEditable = 'true';
				const original = document.createElement( 'div' );
				original.className = 'original';
				original.lang = from;
				original.append( block.cloneNode( true ) );
				rows.append( original, target );
				if ( this.saved ) {
					target.append( this.saved[ i ].cloneNode( true ) );
					return null;
				}
				target.textContent = rows.dataset.translating;
				target.setAttribute( 'aria-busy', 'true' );
				return async () => {
					try {
						target.replaceChildren( await translate( from, to, block, signal ) );
					} catch {
						if ( signal.aborted ) {
							return;
						}
						target.replaceChildren( block.cloneNode( true ) );
						target.lang = from;
						target.classList.add( 'failed' );
						target.title = rows.dataset.failed;
					}
					target.removeAttribute( 'aria-busy' );
				};
			} ).filter( Boolean );
			dialog.showModal();
			if ( jobs.length ) {
				status.textContent = rows.dataset.translating;
				await run( jobs, PARALLEL );
				if ( !signal.aborted ) {
					status.textContent = '';
				}
			}
		}

		// The rows of the dialog, in the place of the blocks on the page:
		// the same elements, their children replaced, so a second edit maps
		// row to block again.
		save( targets ) {
			const { dir } = this.dataset;
			// A row that was not translated keeps the language of its source.
			const langs = targets.map( ( target ) => target.lang );
			this.saved = targets.map( ( target ) => {
				const copy = document.createDocumentFragment();
				copy.append( ...[ ...target.childNodes ].map( ( n ) => n.cloneNode( true ) ) );
				return copy;
			} );
			this.units().forEach( ( unit, i ) => {
				unit.replaceChildren( ...content( this.saved[ i ].cloneNode( true ), unit ) );
				unit.lang = langs[ i ];
				unit.dir = langs[ i ] === this.dataset.to ? dir : '';
			} );
			this.classList.add( 'translated' );
			this.querySelector( '.saved-note' ).hidden = false;
		}
	} );
} )();
// The editor of a label (#label-editor): a label that is not in the page
// language gets its translation in a dialog. Progressive enhancement only:
// without this script, the action of a label is a link to
// Special:SetLabel on Wikidata. The machine translation of Wikimedia
// (MinT, by cxserver) fills the field first, and the reader corrects it.
// "Save" mimics a published edit: every place of the page with the label
// shows the new one. Nothing is sent.
// One function scope: the page scripts share one script element.
( () => {
	const dialog = document.getElementById( 'label-editor' );
	if ( !dialog ) {
		return;
	}
	const MT = 'https://cxserver.wikimedia.org/v2/translate';
	const root = document.documentElement;
	const page = root.lang;
	const input = dialog.querySelector( 'input' );
	const status = dialog.querySelector( '.status' );
	const sourceText = dialog.querySelector( '.source .text' );
	const sourceLang = dialog.querySelector( '.source .source-lang' );
	let names = null;
	try {
		names = new Intl.DisplayNames( root.dataset.locale || page, { type: 'language', fallback: 'none' } );
	} catch ( e ) {
		// The code of the language stays.
	}
	// The labels saved on this page, by the address of their action: the
	// source label, its language, and the saved text.
	const saved = new Map();
	// The address of the action in the dialog, and its request.
	let current = null;
	let controller = null;

	// The label of the group of an action: in a link or bare.
	const labelOf = ( action ) => action.parentElement.querySelector( '.fb, .localized' );

	// The name of a language in the page locale; else its code.
	const nameOf = ( code ) => {
		try {
			return ( names && names.of( code ) ) || code;
		} catch ( e ) {
			return code;
		}
	};

	// The machine translation of a text: the text of the answer only. The
	// answer is parsed in a template, which runs and loads nothing.
	const translate = async ( text, from, signal ) => {
		const p = document.createElement( 'p' );
		p.textContent = text;
		const response = await fetch( `${ MT }/${ from }/${ page }/MinT`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify( { html: `<section>${ p.outerHTML }</section>` } ),
			signal
		} );
		if ( !response.ok ) {
			throw new Error( response.status );
		}
		const { contents } = await response.json();
		const template = document.createElement( 'template' );
		template.innerHTML = contents;
		const result = template.content.textContent.trim();
		if ( !result ) {
			throw new Error( 'empty' );
		}
		return result;
	};

	const open = async ( action ) => {
		current = action.getAttribute( 'href' );
		const label = labelOf( action );
		const entry = saved.get( current ) ||
			{ text: label.textContent, lang: label.lang, value: '' };
		sourceText.textContent = entry.text;
		sourceText.lang = entry.lang;
		sourceLang.textContent = nameOf( entry.lang );
		input.value = entry.value;
		status.textContent = '';
		dialog.showModal();
		input.focus();
		if ( entry.value ) {
			return;
		}
		// A new label: its machine translation, unless the reader has
		// started to write.
		controller = new AbortController();
		status.textContent = status.dataset.translating;
		try {
			const result = await translate( entry.text, entry.lang, controller.signal );
			if ( !input.value ) {
				input.value = result;
				input.select();
			}
			status.textContent = '';
		} catch ( e ) {
			if ( e.name !== 'AbortError' ) {
				status.textContent = status.dataset.failed;
			}
		}
	};

	// Every place of the page with the label shows the saved text, in the
	// page language, marked as saved on this page only.
	const save = () => {
		const value = input.value.trim();
		if ( !current || !value ) {
			return;
		}
		const actions = [ ...document.querySelectorAll( '.fb-group > a.add-label' ) ]
			.filter( ( a ) => a.getAttribute( 'href' ) === current );
		const first = labelOf( actions[ 0 ] );
		const entry = saved.get( current ) || { text: first.textContent, lang: first.lang };
		saved.set( current, { ...entry, value } );
		for ( const action of actions ) {
			const label = labelOf( action );
			label.textContent = value;
			label.lang = page;
			label.dir = root.dir;
			label.title = dialog.dataset.saved;
			label.classList.replace( 'fb', 'localized' );
		}
	};

	dialog.addEventListener( 'close', () => {
		controller?.abort();
		current = null;
		status.textContent = '';
	} );
	dialog.querySelector( '.close' ).addEventListener( 'click', () => dialog.close() );
	dialog.querySelector( '.save' ).addEventListener( 'click', () => {
		save();
		dialog.close();
	} );
	input.addEventListener( 'keydown', ( event ) => {
		if ( event.key === 'Enter' ) {
			save();
			dialog.close();
		}
	} );

	document.addEventListener( 'click', ( event ) => {
		const action = event.target.closest( '.fb-group > a.add-label' );
		if ( action ) {
			event.preventDefault();
			open( action );
			return;
		}
		// A click on a label that is not a link shows its action; a click
		// elsewhere hides it again.
		const group = event.target.closest( '.fb-group' );
		for ( const shown of document.querySelectorAll( '.fb-group.shown' ) ) {
			if ( shown !== group ) {
				shown.classList.remove( 'shown' );
			}
		}
		if ( group && !event.target.closest( 'a' ) ) {
			group.classList.add( 'shown' );
		}
	} );
} )();
// The search of the page header (#search): the Wikidata items that match
// the text, in the page language (wbsearchentities), as a list under the
// field. An item opens its page here, in the page language. Progressive
// enhancement only: without this script, the form opens the search of
// Wikidata. Text only from the answer: nothing of it is parsed as HTML.
// One function scope: the page scripts share one script element.
( () => {
	const form = document.getElementById( 'search' );
	if ( !form ) {
		return;
	}
	const API = 'https://www.wikidata.org/w/api.php';
	const LIMIT = 7;
	// The wait after a key before the request, in milliseconds.
	const DELAY = 200;
	const lang = document.documentElement.lang;
	const input = form.querySelector( '[role=combobox]' );
	const list = form.querySelector( '[role=listbox]' );
	let controller = null;
	let timer = 0;
	// The option that the arrow keys chose; -1 for none.
	let active = -1;

	const options = () => [ ...list.children ];

	const choose = ( index ) => {
		const all = options();
		active = index;
		all.forEach( ( o, i ) => o.setAttribute( 'aria-selected', String( i === index ) ) );
		if ( index < 0 ) {
			input.removeAttribute( 'aria-activedescendant' );
			return;
		}
		input.setAttribute( 'aria-activedescendant', all[ index ].id );
		all[ index ].scrollIntoView( { block: 'nearest' } );
	};

	const show = ( shown ) => {
		list.hidden = !shown;
		input.setAttribute( 'aria-expanded', String( shown ) );
		if ( !shown ) {
			choose( -1 );
		}
	};

	// An item: its label (its id when it has none) and its description.
	const option = ( item, index ) => {
		const li = document.createElement( 'li' );
		li.id = `search-option-${ index }`;
		li.setAttribute( 'role', 'option' );
		li.setAttribute( 'aria-selected', 'false' );
		const a = document.createElement( 'a' );
		a.href = form.dataset.base + item.id;
		a.tabIndex = -1;
		const label = document.createElement( 'span' );
		label.textContent = item.label || item.id;
		a.append( label );
		if ( item.description ) {
			const description = document.createElement( 'span' );
			description.className = 'description';
			description.textContent = item.description;
			a.append( description );
		}
		li.append( a );
		return li;
	};

	// The items of a text in the list. The number of items; 0 also for a
	// failed request.
	const search = async ( text ) => {
		controller?.abort();
		controller = new AbortController();
		const params = new URLSearchParams( {
			action: 'wbsearchentities',
			search: text,
			language: lang,
			uselang: lang,
			type: 'item',
			limit: LIMIT,
			format: 'json',
			origin: '*'
		} );
		try {
			const response = await fetch( `${ API }?${ params }`, { signal: controller.signal } );
			const { search: items = [] } = response.ok ? await response.json() : {};
			list.replaceChildren( ...items.map( option ) );
			show( items.length > 0 );
			return items.length;
		} catch ( e ) {
			if ( e.name !== 'AbortError' ) {
				list.replaceChildren();
				show( false );
			}
			return 0;
		}
	};

	const open = ( li ) => location.assign( li.querySelector( 'a' ).href );

	input.addEventListener( 'input', () => {
		clearTimeout( timer );
		choose( -1 );
		const text = input.value.trim();
		if ( !text ) {
			controller?.abort();
			list.replaceChildren();
			show( false );
			return;
		}
		timer = setTimeout( () => search( text ), DELAY );
	} );

	input.addEventListener( 'keydown', ( event ) => {
		const count = options().length;
		if ( ( event.key === 'ArrowDown' || event.key === 'ArrowUp' ) && count ) {
			event.preventDefault();
			show( true );
			// From the field to the first option, from the last option
			// back to the field; and up the other way.
			const step = event.key === 'ArrowDown' ? 1 : count;
			choose( ( active + 1 + step ) % ( count + 1 ) - 1 );
		} else if ( event.key === 'Escape' && !list.hidden ) {
			// The first Escape closes the list; the next clears the field.
			event.preventDefault();
			show( false );
		}
	} );

	// Enter: the chosen option, or else the first item of the text. A text
	// whose items have not come yet waits for them.
	form.addEventListener( 'submit', async ( event ) => {
		event.preventDefault();
		const chosen = options()[ active ];
		if ( chosen ) {
			open( chosen );
			return;
		}
		clearTimeout( timer );
		const text = input.value.trim();
		if ( text && await search( text ) ) {
			open( options()[ 0 ] );
		}
	} );

	input.addEventListener( 'focus', () => show( options().length > 0 ) );
	input.addEventListener( 'blur', () => show( false ) );
	// A click on an option keeps the focus in the field: the list stays
	// until the link opens.
	list.addEventListener( 'mousedown', ( event ) => event.preventDefault() );
} )();
// Progressive enhancement only: a link in the contents drawer (a narrow
// page) closes the drawer, so the reader sees the spread it goes to. A
// popover does not close when a link in it is clicked. Without this
// script, a tap outside the drawer or Escape closes it.
( () => {
	document.getElementById( 'toc' )?.addEventListener( 'click', ( event ) => {
		const toc = event.currentTarget;
		if ( event.target.closest( 'a' ) && toc.matches( ':popover-open' ) ) {
			toc.hidePopover();
		}
	} );
} )();
// The qr-names element: the names of the item in many languages, as one
// choice of language and the group of that language. Progressive
// enhancement only: the server renders every group, the page language
// first; this script shows the choice and one group, and decides nothing.
if ( 'customElements' in window ) {
	customElements.define( 'qr-names', class extends HTMLElement {
		connectedCallback() {
			const choice = this.querySelector( '.name-choice' );
			const groups = [ ...this.querySelectorAll( '.name-group' ) ];
			if ( !choice || groups.length < 2 ) {
				return;
			}
			const show = ( lang ) => groups.forEach( ( group ) => {
				group.hidden = group.dataset.lang !== lang;
			} );
			choice.hidden = false;
			show( choice.value );
			choice.addEventListener( 'change', () => show( choice.value ) );
		}
	} );
}
// The qr-chart element: the points of a series (the columns of its table)
// as a line chart, a line for each column, drawn by ECharts. Progressive enhancement only: the server
// renders the table, and without this script or without ECharts the table
// stays. The script reads the rows and decides nothing. ECharts loads
// once, when the first chart comes near the viewport, so it does not block
// the render.
if ( 'customElements' in window && 'IntersectionObserver' in window ) {
	const root = document.documentElement;
	// The design base is on a page that the server sends (not in a file).
	const src = root.dataset.design && `${ root.dataset.design }/echarts.js`;
	const locale = root.dataset.locale || root.lang;
	let loading;
	const echarts = () => loading ??= new Promise( ( resolve, reject ) => {
		const script = document.createElement( 'script' );
		script.src = src;
		script.async = true;
		script.onload = () => resolve( window.echarts );
		script.onerror = reject;
		document.head.append( script );
	} );
	const near = new IntersectionObserver( ( entries ) => {
		for ( const entry of entries ) {
			if ( entry.isIntersecting ) {
				near.unobserve( entry.target );
				entry.target.draw();
			}
		}
	}, { rootMargin: '200px' } );

	customElements.define( 'qr-chart', class extends HTMLElement {
		connectedCallback() {
			if ( src ) {
				near.observe( this );
			}
		}

		disconnectedCallback() {
			near.unobserve( this );
		}

		async draw() {
			const box = this.querySelector( '.chart' );
			const rows = [ ...this.querySelectorAll( 'tbody tr[data-year]' ) ];
			const names = [ ...this.querySelectorAll( 'thead th' ) ].slice( 1 )
				.map( ( th ) => th.textContent.trim() );
			// A line goes through one value of each year; the other values of
			// a year (other sources) are marks off the line.
			const lines = names.map( ( name, i ) => {
				const cells = rows.map( ( row ) => [ Number( row.dataset.year ), row.cells[ i + 1 ] ] );
				return {
					name,
					points: cells.filter( ( [ , td ] ) => td && 'amount' in td.dataset )
						.map( ( [ y, td ] ) => [ y, Number( td.dataset.amount ) ] ),
					others: cells.flatMap( ( [ y, td ] ) => td ?
						[ ...td.querySelectorAll( '[data-other]' ) ].map( ( o ) => [ y, Number( o.dataset.other ) ] ) :
						[] )
				};
			} );
			const otherNote = this.querySelector( '[data-other] .note' )?.textContent ?? '';
			if ( !box || !lines.some( ( l ) => l.points.length ) ) {
				return;
			}
			let lib;
			try {
				lib = await echarts();
			} catch ( e ) {
				return; // The table stays.
			}
			let year, exact, short;
			try {
				year = new Intl.NumberFormat( locale, { useGrouping: false } );
				exact = new Intl.NumberFormat( locale, { maximumFractionDigits: 20 } );
				short = new Intl.NumberFormat( locale, { notation: 'compact', maximumSignificantDigits: 4 } );
			} catch ( e ) {
				return;
			}
			const style = getComputedStyle( this );
			const token = ( name ) => style.getPropertyValue( name ).trim();
			const subtle = token( '--color-subtle' );
			const rtl = getComputedStyle( box ).direction === 'rtl';
			const single = lines.length === 1;
			// One line: the colour of the dimension. Lines of a split: the
			// colours of the parts, as in their key.
			const colour = ( i ) => token( single ? '--ink' : `--part-${ i + 1 }` );
			const years = [ ...new Set( lines.flatMap( ( l ) => l.points.map( ( [ y ] ) => y ) ) ) ]
				.sort( ( a, b ) => a - b );
			const few = years.length <= 6;
			const html = lib.format.encodeHTML;
			const pad = ( min, max ) => Math.max( 0.5, ( max - min ) * 0.1 );

			const plot = document.createElement( 'div' );
			plot.className = 'plot';
			plot.setAttribute( 'aria-hidden', 'true' );
			// The options turn the chart for a right-to-left page; the SVG
			// text must not turn again by the page direction.
			plot.dir = 'ltr';
			box.append( plot );
			const chart = lib.init( plot, null, { renderer: 'svg' } );
			chart.setOption( {
				animation: false,
				textStyle: { fontFamily: style.fontFamily },
				grid: { left: 8, right: 16, top: 24, bottom: 8, containLabel: true },
				tooltip: {
					trigger: 'axis',
					backgroundColor: token( '--background-color-base' ),
					borderColor: token( '--border-color-base' ),
					textStyle: { color: token( '--color-base' ) },
					// Each series gives its nearest point: only the values of
					// the year of a line's point. Series 2i is line i, 2i + 1
					// its other values.
					formatter: ( params ) => {
						const at = ( params.find( ( p ) => p.seriesIndex % 2 === 0 ) ?? params[ 0 ] ).value[ 0 ];
						const value = ( p ) => exact.format( p.value[ 1 ] ) +
							( p.seriesIndex % 2 ? ` (${ html( otherNote ) })` : '' );
						const of = params.filter( ( p ) => p.value[ 0 ] === at );
						if ( single ) {
							return `${ year.format( at ) }: ${ of.map( value ).join( ' · ' ) }`;
						}
						return [ year.format( at ), ...of.map( ( p ) =>
							`${ p.marker }${ html( p.seriesName ) }: ${ value( p ) }` ) ].join( '<br>' );
					}
				},
				xAxis: {
					type: 'value',
					inverse: rtl,
					// Room at each end for the end points and their numbers.
					min: ( { min, max } ) => min - pad( min, max ),
					max: ( { min, max } ) => max + pad( min, max ),
					minInterval: 1,
					splitLine: { show: false },
					axisLine: { lineStyle: { color: token( '--border-color-base' ) } },
					// A few points: each year of the data has its label.
					axisTick: few ? { customValues: years } : {},
					axisLabel: {
						color: subtle,
						hideOverlap: true,
						...( few ? { customValues: years } : {} ),
						formatter: ( v ) => Number.isInteger( v ) ? year.format( v ) : ''
					}
				},
				yAxis: {
					type: 'value',
					position: rtl ? 'right' : 'left',
					scale: true,
					splitLine: { lineStyle: { color: token( '--border-color-subtle' ) } },
					axisLabel: { color: subtle, formatter: ( v ) => short.format( v ) }
				},
				series: lines.flatMap( ( l, i ) => [ {
					type: 'line',
					name: l.name,
					data: l.points,
					color: colour( i ),
					symbolSize: 6,
					showSymbol: l.points.length <= 24,
					label: {
						// The numbers on the points of one short line; with
						// lines, they would cover each other.
						show: single && few,
						color: subtle,
						formatter: ( p ) => short.format( p.value[ 1 ] )
					}
				}, {
					type: 'scatter',
					name: l.name,
					data: l.others,
					color: colour( i ),
					symbol: 'emptyCircle',
					symbolSize: 7
				} ] )
			} );
			this.classList.add( 'drawn' );
			new ResizeObserver( () => chart.resize() ).observe( box );
		}
	} );
}
</script>
</body>
</html>
