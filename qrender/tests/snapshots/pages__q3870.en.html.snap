                <p class="prose-links"><a href="https://en.wikipedia.org/wiki/Nairobi#Parks_and_gardens">Parks and gardens</a> · <a href="https://en.wikipedia.org/wiki/Nairobi#Political_divisions">Political divisions</a> · <a href="https://en.wikipedia.org/wiki/Nairobi#Demographics">Demographics</a> · <a href="https://en.wikipedia.org/wiki/Nairobi#Sports">Sports</a> · <a href="https://en.wikipedia.org/wiki/Nairobi#Places_of_worship">Places of worship</a> · <a href="https://en.wikipedia.org/wiki/Nairobi#Education">Education</a> · <a href="https://en.wikipedia.org/wiki/Nairobi#Infrastructure">Infrastructure</a> · <a href="https://en.wikipedia.org/wiki/Nairobi#Crime_and_law_enforcement">Crime and law enforcement</a> · <a href="https://en.wikipedia.org/wiki/Nairobi#Media">Media</a> · <a href="https://en.wikipedia.org/wiki/Nairobi#Notable_people">Notable people</a> · <a href="https://en.wikipedia.org/wiki/Nairobi#Pop_culture">Pop culture</a></p>
            </section>
        <p class="provenance-note">Composed by rule from Wikidata item <a href="https://www.wikidata.org/wiki/Q3870">Q3870</a> (composition/0.3, view/0.2, design/0.2). The lead paragraph, the section paragraphs and the section links come from Wikipedia. Pictures come from Wikimedia Commons; a W on a picture marks one from an article, not from Wikidata; a W on a value marks a statement whose only reference is a Wikipedia.</p>
    </main>
    <script>// Progressive enhancement only: opens and closes dialogs in browsers
// without the invoker commands API. The content does not need it.
if ( !( 'commandForElement' in HTMLButtonElement.prototype ) ) {
	document.addEventListener( 'click', ( event ) => {
		const button = event.target.closest( 'button[commandfor]' );
		if ( !button ) {
			return;
		}
		const target = document.getElementById( button.getAttribute( 'commandfor' ) );
		if ( !target ) {
			return;
		}
		if ( button.getAttribute( 'command' ) === 'close' ) {
			target.close();
		} else {
			target.showModal();
		}
	} );
}
// Progressive enhancement only: numbers, dates and language names in the
// formats of the page locale, by the browser's Intl. The server writes a neutral text
// (digits without grouping, ISO dates); without this script it stays,
// correct but not localized.
( () => {
	const locale = document.documentElement.dataset.locale || document.documentElement.lang;
	// The name of a language in the page locale, for its code
	// (data-lang-name). A code that the browser does not know stays.
	try {
		const languages = new Intl.DisplayNames( locale, { type: 'language', fallback: 'none' } );
		for ( const el of document.querySelectorAll( '[data-lang-name]' ) ) {
			try {
				const name = languages.of( el.dataset.langName );
				if ( name ) {
					el.textContent = name;
				}
			} catch ( e ) {
				// Not a language code: the code stays.
			}
		}
	} catch ( e ) {
		// No Intl.DisplayNames: the codes stay.
	}
	let number, percent;
	try {
		number = new Intl.NumberFormat( locale, { maximumFractionDigits: 20 } );
		percent = new Intl.NumberFormat( locale, { style: 'percent', maximumSignificantDigits: 2 } );
	} catch ( e ) {
		return;
	}
	for ( const el of document.querySelectorAll( 'data[data-f]' ) ) {
		const value = Number( el.value );
		if ( Number.isNaN( value ) ) {
			continue;
		}
		if ( el.dataset.f === 'number' ) {
			el.textContent = number.format( value );
		} else if ( el.dataset.f === 'percent' ) {
			el.textContent = percent.format( value );
		}
		// "scientific" keeps its neutral text: m × 10ⁿ.
	}
	// Wikidata precision: 9 year, 10 month, 11 day.
	const options = {
		9: { year: 'numeric' },
		10: { year: 'numeric', month: 'long' },
		11: { year: 'numeric', month: 'long', day: 'numeric' }
	};
	for ( const el of document.querySelectorAll( 'time[datetime][data-p]' ) ) {
		const [ year, month = 1, day = 1 ] = el.dateTime.split( '-' ).map( Number );
		const date = new Date( Date.UTC( 2000, month - 1, day ) );
		date.setUTCFullYear( year ); // Date.UTC reads years below 100 as 19xx
		try {
			el.textContent = new Intl.DateTimeFormat( locale,
				{ ...options[ Math.min( Number( el.dataset.p ), 11 ) ], timeZone: 'UTC' } ).format( date );
		} catch ( e ) {
			// The neutral text stays.
		}
	}
} )();
// Progressive enhancement only: a play link (a.play) of an audio file
// plays the file in the page; a second click stops it. One sound plays at
// a time. Without this script the link opens the file, and the browser
// plays it.
( () => {
	let sound, link;
	const stop = () => {
		sound.pause();
		link.classList.remove( 'playing' );
		sound = link = null;
	};
	document.addEventListener( 'click', ( event ) => {
		const a = event.target.closest( 'a.play' );
		if ( !a ) {
			return;
		}
		event.preventDefault();
		const again = link === a;
		if ( sound ) {
			stop();
		}
		if ( again ) {
			return;
		}
		sound = new Audio( a.href );
		link = a;
		a.classList.add( 'playing' );
		sound.addEventListener( 'ended', () => link === a && stop() );
		sound.play().catch( () => {
			window.location.href = a.href;
		} );
	} );
} )();
// Progressive enhancement only: a video plays in its dialog. It starts when
// the dialog opens (the reader asked for it with the play button), and it
// stops when the dialog closes. Without this script, the reader starts it
// with its controls, and it plays on after the dialog closes.
// The toggle and close events of a dialog do not bubble: they are heard in
// the capture phase.
document.addEventListener( 'toggle', ( event ) => {
	if ( event.newState === 'open' && event.target.matches( 'dialog.lightbox' ) ) {
		// A browser can refuse to play; the controls are there.
		event.target.querySelector( 'video' )?.play().catch( () => {} );
	}
}, true );

document.addEventListener( 'close', ( event ) => {
	event.target.querySelector( 'video' )?.pause();
}, true );
// The qr-model element: a 3D model (a binary STL file) that the reader turns
// (drag) and zooms (wheel), drawn by WebGL2 with no library. Progressive
// enhancement only: the element holds the picture that Commons renders from
// the file, and without WebGL2 or this script the picture stays. The file is
// large (tens of MB), so it loads only when the dialog of the element opens,
// and a close stops the load. A model that is loaded stays.
// One function scope: the page scripts share one script element.
( () => {
	if ( !( 'customElements' in window ) ) {
		return;
	}

	const percent = new Intl.NumberFormat( document.documentElement.lang, { style: 'percent' } );

	customElements.define( 'qr-model', class extends HTMLElement {
		connectedCallback() {
			this.dialog = this.closest( 'dialog' );
			this.dialog?.addEventListener( 'toggle', ( event ) => {
				if ( event.newState === 'open' ) {
					this.open();
				} else {
					this.controller?.abort();
				}
			} );
		}

		async open() {
			if ( this.controller || this.done ) {
				return;
			}
			const canvas = document.createElement( 'canvas' );
			const gl = canvas.getContext( 'webgl2' );
			if ( !gl ) {
				return;
			}
			const status = this.querySelector( '.status' );
			const total = Number( this.dataset.bytes );
			const progress = ( received ) => {
				status.textContent = this.dataset.loading.replace( '$1', total ? percent.format( received / total ) : '' );
			};
			this.controller = new AbortController();
			progress( 0 );
			try {
				const buffer = await load( this.getAttribute( 'src' ), this.controller.signal, progress );
				const mesh = parse( buffer );
				status.textContent = mesh ? '' : this.dataset.unsupported;
				if ( mesh ) {
					draw( this, canvas, gl, mesh );
				}
				this.done = true;
			} catch {
				// Stopped or failed: the picture stays, and the next open tries again.
				status.textContent = '';
			} finally {
				this.controller = null;
			}
		}
	} );

	async function load( url, signal, progress ) {
		const response = await fetch( url, { signal } );
		if ( !response.ok ) {
			throw new Error( response.status );
		}
		const reader = response.body.getReader();
		const chunks = [];
		let received = 0;
		for ( ;; ) {
			const { done, value } = await reader.read();
			if ( done ) {
				break;
			}
			chunks.push( value );
			received += value.length;
			progress( received );
		}
		const buffer = new Uint8Array( received );
		let offset = 0;
		for ( const chunk of chunks ) {
			buffer.set( chunk, offset );
			offset += chunk.length;
		}
		return buffer.buffer;
	}

	// Binary STL: an 80-byte header, a triangle count, then 50 bytes a triangle.
	// A file of another size is not binary STL (an ASCII STL): null. Normals
	// come from the vertices; the stored ones are often empty.
	function parse( buffer ) {
		const view = new DataView( buffer );
		const count = buffer.byteLength >= 84 ? view.getUint32( 80, true ) : 0;
		if ( !count || buffer.byteLength !== 84 + count * 50 ) {
			return null;
		}
		const position = new Float32Array( count * 9 );
		const normal = new Float32Array( count * 9 );
		const min = [ Infinity, Infinity, Infinity ], max = [ -Infinity, -Infinity, -Infinity ];
		for ( let i = 0; i < count; i++ ) {
			const base = 84 + i * 50 + 12;
			for ( let j = 0; j < 9; j++ ) {
				const v = view.getFloat32( base + j * 4, true );
				position[ i * 9 + j ] = v;
				min[ j % 3 ] = Math.min( min[ j % 3 ], v );
				max[ j % 3 ] = Math.max( max[ j % 3 ], v );
			}
			const p = position.subarray( i * 9, i * 9 + 9 );
			const ux = p[ 3 ] - p[ 0 ], uy = p[ 4 ] - p[ 1 ], uz = p[ 5 ] - p[ 2 ];
			const vx = p[ 6 ] - p[ 0 ], vy = p[ 7 ] - p[ 1 ], vz = p[ 8 ] - p[ 2 ];
			let nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx;
			const length = Math.hypot( nx, ny, nz ) || 1;
			nx /= length; ny /= length; nz /= length;
			for ( let k = 0; k < 3; k++ ) {
				normal[ i * 9 + k * 3 ] = nx; normal[ i * 9 + k * 3 + 1 ] = ny; normal[ i * 9 + k * 3 + 2 ] = nz;
			}
		}
		const centre = [ 0, 1, 2 ].map( ( k ) => ( min[ k ] + max[ k ] ) / 2 );
		const size = Math.max( max[ 0 ] - min[ 0 ], max[ 1 ] - min[ 1 ], max[ 2 ] - min[ 2 ] );
		return { position, normal, count: count * 3, centre, size };
	}

	// The mesh, grey and lit from the upper left, on a transparent canvas (the
	// stage of the dialog gives the background). It turns slowly until the
	// reader drags it, and not at all with reduced motion. It is drawn only
	// while its dialog is open.
	function draw( element, canvas, gl, mesh ) {
		const program = gl.createProgram();
		[ [ gl.VERTEX_SHADER, `#version 300 es
			in vec3 position; in vec3 normal;
			uniform mat4 model; uniform mat4 projection;
			out vec3 vNormal;
			void main() {
				vNormal = mat3( model ) * normal;
				gl_Position = projection * model * vec4( position, 1.0 );
			}` ], [ gl.FRAGMENT_SHADER, `#version 300 es
			precision mediump float;
			in vec3 vNormal; out vec4 colour;
			void main() {
				float light = max( dot( normalize( vNormal ), normalize( vec3( -0.5, 0.6, 0.8 ) ) ), 0.0 );
				colour = vec4( vec3( 0.12 + 0.82 * light ), 1.0 );
			}` ] ].forEach( ( [ type, source ] ) => {
			const shader = gl.createShader( type );
			gl.shaderSource( shader, source );
			gl.compileShader( shader );
			gl.attachShader( program, shader );
		} );
		gl.linkProgram( program );
		gl.useProgram( program );
		[ [ 'position', mesh.position ], [ 'normal', mesh.normal ] ].forEach( ( [ name, data ] ) => {
			gl.bindBuffer( gl.ARRAY_BUFFER, gl.createBuffer() );
			gl.bufferData( gl.ARRAY_BUFFER, data, gl.STATIC_DRAW );
			const location = gl.getAttribLocation( program, name );
			gl.enableVertexAttribArray( location );
			gl.vertexAttribPointer( location, 3, gl.FLOAT, false, 0, 0 );
		} );
		gl.enable( gl.DEPTH_TEST );
		gl.enable( gl.CULL_FACE );
		gl.clearColor( 0, 0, 0, 0 );
		const modelAt = gl.getUniformLocation( program, 'model' );
		const projectionAt = gl.getUniformLocation( program, 'projection' );
		const count = mesh.count, s = 2 / mesh.size, [ cx, cy, cz ] = mesh.centre;

		const still = matchMedia( '(prefers-reduced-motion: reduce)' ).matches;
		let yaw = 0, pitch = 0.3, distance = 3.4, dragging = null, spinning = !still, pending = 0;

		function frame() {
			pending = 0;
			if ( !element.dialog.open ) {
				return;
			}
			const w = canvas.clientWidth * devicePixelRatio, h = canvas.clientHeight * devicePixelRatio;
			if ( canvas.width !== w || canvas.height !== h ) {
				canvas.width = w;
				canvas.height = h;
			}
			gl.viewport( 0, 0, w, h );
			gl.clear( gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT );
			if ( spinning ) {
				yaw += 0.003;
			}
			const cyw = Math.cos( yaw ), syw = Math.sin( yaw ), cp = Math.cos( pitch ), sp = Math.sin( pitch );
			// model = translate(0,0,-distance) * rotateX(pitch) * rotateY(yaw) * scale * translate(-centre)
			const r = [ cyw, sp * syw, -cp * syw, 0, 0, cp, sp, 0, syw, -sp * cyw, cp * cyw, 0 ];
			const model = new Float32Array( 16 );
			for ( let c = 0; c < 3; c++ ) {
				for ( let k = 0; k < 3; k++ ) {
					model[ c * 4 + k ] = r[ c * 4 + k ] * s;
				}
			}
			for ( let k = 0; k < 3; k++ ) {
				model[ 12 + k ] = -( r[ k ] * cx + r[ 4 + k ] * cy + r[ 8 + k ] * cz ) * s;
			}
			model[ 14 ] -= distance;
			model[ 15 ] = 1;
			const f = 1 / Math.tan( 0.4 ), near = 0.1, far = 20, aspect = w / h;
			const projection = new Float32Array( [ f / aspect, 0, 0, 0, 0, f, 0, 0, 0, 0, ( far + near ) / ( near - far ), -1, 0, 0, 2 * far * near / ( near - far ), 0 ] );
			gl.uniformMatrix4fv( modelAt, false, model );
			gl.uniformMatrix4fv( projectionAt, false, projection );
			gl.drawArrays( gl.TRIANGLES, 0, count );
			run();
		}
		const run = () => {
			pending ||= requestAnimationFrame( frame );
		};

		canvas.addEventListener( 'pointerdown', ( event ) => {
			dragging = [ event.clientX, event.clientY ];
			spinning = false;
			canvas.setPointerCapture( event.pointerId );
		} );
		canvas.addEventListener( 'pointermove', ( event ) => {
			if ( !dragging ) {
				return;
			}
			yaw += ( event.clientX - dragging[ 0 ] ) * 0.01;
			pitch = Math.max( -1.5, Math.min( 1.5, pitch + ( event.clientY - dragging[ 1 ] ) * 0.01 ) );
			dragging = [ event.clientX, event.clientY ];
		} );
		canvas.addEventListener( 'pointerup', () => {
			dragging = null;
		} );
		canvas.addEventListener( 'wheel', ( event ) => {
			event.preventDefault();
			distance = Math.max( 1.2, Math.min( 6, distance * ( 1 + event.deltaY * 0.001 ) ) );
		}, { passive: false } );
