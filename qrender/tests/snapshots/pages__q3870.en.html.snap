			map.attributionControl.setPrefix( false );
			map.fitBounds( data.bounds );
			L.tileLayer( tiles, { maxZoom: 18, attribution } ).addTo( map );
			for ( const outline of data.outlines ) {
				const className = outline.main ? 'main' : 'other';
				if ( outline.rings.length ) {
					L.polygon( outline.rings, { className, interactive: false } ).addTo( map );
				}
				if ( outline.lines.length ) {
					L.polyline( outline.lines, { className: `${ className } open`, interactive: false } ).addTo( map );
				}
			}
			for ( const marker of data.markers ) {
				L.marker( marker.at, { icon: icon( 'marker' ), title: marker.label, keyboard: false } ).addTo( map );
			}
			L.marker( data.pin, { icon: icon( 'pin' ), interactive: false, keyboard: false } ).addTo( map );
		}
	} );
} )();
// The qr-section element: a text of the article in another language (the
// page language has no article), which the reader translates into the page
// language. Progressive enhancement only: the server renders the text, and
// every word of the editor in the dialog of the page (#translator); without
// this script the text stays and the button stays hidden. On "Translate",
// the dialog opens: each block of the text (its title, a paragraph, a list,
// the title of a subsection) goes to the machine translation of Wikimedia
// (MinT, by cxserver), a few at a time, and its translation comes in an
// editable row beside it. "Save" mimics a published edit: the section on
// the page shows the translation. Nothing is sent.
// One function scope: the page scripts share one script element.
( () => {
	const dialog = document.getElementById( 'translator' );
	if ( !dialog || !( 'customElements' in window ) ) {
		return;
	}
	const MT = 'https://cxserver.wikimedia.org/v2/translate';
	// Requests at a time: MinT takes about 1.5 s for a paragraph.
	const PARALLEL = 4;
	const BLOCKS = 'p, ul, ol, dl, blockquote';
	// What a translation may hold: the tags of the text, links to the web.
	const ALLOWED = new Set( [ 'P', 'UL', 'OL', 'LI', 'DL', 'DT', 'DD', 'BLOCKQUOTE',
		'H3', 'H4', 'H5', 'H6', 'A', 'B', 'I', 'SPAN' ] );
	const rows = dialog.querySelector( '.rows' );
	const status = dialog.querySelector( '.status' );
	// The section in the dialog, and the requests of its translation.
	let current = null;
	let controller = null;

	// The blocks of a text, in order: a subsection gives its title, then
	// its blocks; a collapsed part without a title (the rest of the lead)
	// gives its blocks.
	const units = ( container ) => [ ...container.children ].flatMap( ( el ) => {
		if ( el.matches( BLOCKS ) ) {
			return [ el ];
		}
		if ( el.matches( 'details' ) ) {
			const title = el.querySelector( ':scope > summary > :is( h3, h4, h5, h6 )' );
			const rest = units( el );
			return title ? [ title, ...rest ] : rest;
		}
		return [];
	} );

	// A block without the glosses of its links (the labels in the page
	// language): the machine translation reads the source text only.
	const source = ( el ) => {
		const copy = el.cloneNode( true );
		copy.querySelectorAll( 'rt' ).forEach( ( rt ) => rt.remove() );
		copy.querySelectorAll( 'ruby' ).forEach( ( ruby ) => ruby.replaceWith( ...ruby.childNodes ) );
		return copy;
	};

	// Untrusted HTML of the service, cleaned: an element that is not
	// allowed leaves its text; no attribute but an http(s) link.
	const clean = ( html ) => {
		const template = document.createElement( 'template' );
		template.innerHTML = html;
		const walk = ( node ) => {
			for ( const child of [ ...node.children ] ) {
				walk( child );
				if ( !ALLOWED.has( child.tagName ) ) {
					child.replaceWith( ...child.childNodes );
					continue;
				}
				for ( const { name, value } of [ ...child.attributes ] ) {
					if ( !( name === 'href' && /^https?:\/\//.test( value ) ) ) {
						child.removeAttribute( name );
					}
				}
			}
		};
		walk( template.content );
		return template.content;
	};

	const translate = async ( from, to, el, signal ) => {
		// MinT translates the first element only: one block in a section.
		const response = await fetch( `${ MT }/${ from }/${ to }/MinT`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify( { html: `<section>${ el.outerHTML }</section>` } ),
			signal
		} );
		if ( !response.ok ) {
			throw new Error( response.status );
		}
		const { contents } = await response.json();
		const fragment = clean( contents );
		if ( !fragment.textContent.trim() ) {
			throw new Error( 'empty' );
		}
		return fragment;
	};

	// The jobs, `n` at a time.
	const run = async ( jobs, n ) => {
		let next = 0;
		await Promise.all( Array.from( { length: n }, async () => {
			while ( next < jobs.length ) {
				await jobs[ next++ ]();
			}
		} ) );
	};

	// The content of a translated row: the children of its block when it
	// is of the same kind as the source (a paragraph for a paragraph).
	const content = ( target, unit ) => {
		const el = target.firstElementChild;
		return el && el.tagName === unit.tagName && target.children.length === 1 ?
			[ ...el.childNodes ] : [ ...target.childNodes ];
	};

	dialog.addEventListener( 'close', () => {
		controller?.abort();
		current = null;
		rows.replaceChildren();
		status.textContent = '';
	} );
	dialog.querySelector( '.discard' ).addEventListener( 'click', () => dialog.close() );
	dialog.querySelector( '.save' ).addEventListener( 'click', () => {
		current?.save( [ ...rows.querySelectorAll( '.translated' ) ] );
		dialog.close();
	} );

	customElements.define( 'qr-section', class extends HTMLElement {
		connectedCallback() {
			// The section's own button and text, not those of a section in it.
			this.button = this.querySelector( '.translate' );
			this.heading = this.querySelector( ':scope > .head > :is( h3, h4, h5, h6 ), :scope > details > .head > :is( h3, h4, h5, h6 )' );
			this.body = this.querySelector( ':scope > .body, :scope > details > .body' );
			if ( !this.button || !this.body ) {
				return;
			}
			this.button.hidden = false;
			this.button.addEventListener( 'click', ( event ) => {
				// In a summary, the click would also close the section.
				event.preventDefault();
				this.open();
			} );
		}

		// The blocks on the page: the title first, then the text.
		units() {
			return [ ...( this.heading ? [ this.heading ] : [] ), ...units( this.body ) ];
		}

		async open() {
			if ( dialog.open ) {
				return;
			}
			const { from, to, dir } = this.dataset;
			// The English blocks of the first open: after a save, the page
			// shows the translation.
			this.sources ??= this.units().map( source );
			current = this;
			controller = new AbortController();
			const { signal } = controller;
			dialog.querySelector( '.section-title' ).textContent =
				this.heading ? ` · ${ this.sources[ 0 ].textContent }` : '';
			const jobs = this.sources.map( ( block, i ) => {
				const target = document.createElement( 'div' );
				target.className = 'translated';
				target.lang = to;
				target.dir = dir;
				target.contentEditable = 'true';
				const original = document.createElement( 'div' );
				original.className = 'original';
				original.lang = from;
				original.append( block.cloneNode( true ) );
				rows.append( original, target );
				if ( this.saved ) {
					target.append( this.saved[ i ].cloneNode( true ) );
					return null;
				}
				target.textContent = rows.dataset.translating;
				target.setAttribute( 'aria-busy', 'true' );
				return async () => {
					try {
						target.replaceChildren( await translate( from, to, block, signal ) );
					} catch {
						if ( signal.aborted ) {
							return;
						}
						target.replaceChildren( block.cloneNode( true ) );
						target.lang = from;
						target.classList.add( 'failed' );
						target.title = rows.dataset.failed;
					}
					target.removeAttribute( 'aria-busy' );
				};
			} ).filter( Boolean );
			dialog.showModal();
			if ( jobs.length ) {
				status.textContent = rows.dataset.translating;
				await run( jobs, PARALLEL );
				if ( !signal.aborted ) {
					status.textContent = '';
				}
			}
		}

		// The rows of the dialog, in the place of the blocks on the page:
		// the same elements, their children replaced, so a second edit maps
		// row to block again.
		save( targets ) {
			const { dir } = this.dataset;
			// A row that was not translated keeps the language of its source.
			const langs = targets.map( ( target ) => target.lang );
			this.saved = targets.map( ( target ) => {
				const copy = document.createDocumentFragment();
				copy.append( ...[ ...target.childNodes ].map( ( n ) => n.cloneNode( true ) ) );
				return copy;
			} );
			this.units().forEach( ( unit, i ) => {
				unit.replaceChildren( ...content( this.saved[ i ].cloneNode( true ), unit ) );
				unit.lang = langs[ i ];
				unit.dir = langs[ i ] === this.dataset.to ? dir : '';
			} );
			this.classList.add( 'translated' );
			this.querySelector( '.saved-note' ).hidden = false;
		}
	} );
} )();
// The qr-names element: the names of the item in many languages, as one
// choice of language and the group of that language. Progressive
// enhancement only: the server renders every group, the page language
// first; this script shows the choice and one group, and decides nothing.
if ( 'customElements' in window ) {
	customElements.define( 'qr-names', class extends HTMLElement {
		connectedCallback() {
			const choice = this.querySelector( '.name-choice' );
			const groups = [ ...this.querySelectorAll( '.name-group' ) ];
			if ( !choice || groups.length < 2 ) {
				return;
			}
			const show = ( lang ) => groups.forEach( ( group ) => {
				group.hidden = group.dataset.lang !== lang;
			} );
			choice.hidden = false;
			show( choice.value );
			choice.addEventListener( 'change', () => show( choice.value ) );
		}
	} );
}
// The qr-chart element: the points of a series (the columns of its table)
// as a line chart, a line for each column, drawn by ECharts. Progressive enhancement only: the server
// renders the table, and without this script or without ECharts the table
// stays. The script reads the rows and decides nothing. ECharts loads
// once, when the first chart comes near the viewport, so it does not block
// the render.
if ( 'customElements' in window && 'IntersectionObserver' in window ) {
	const root = document.documentElement;
	// The design base is on a page that the server sends (not in a file).
	const src = root.dataset.design && `${ root.dataset.design }/echarts.js`;
	const locale = root.dataset.locale || root.lang;
	let loading;
	const echarts = () => loading ??= new Promise( ( resolve, reject ) => {
		const script = document.createElement( 'script' );
		script.src = src;
		script.async = true;
		script.onload = () => resolve( window.echarts );
		script.onerror = reject;
		document.head.append( script );
	} );
	const near = new IntersectionObserver( ( entries ) => {
		for ( const entry of entries ) {
			if ( entry.isIntersecting ) {
				near.unobserve( entry.target );
				entry.target.draw();
			}
		}
	}, { rootMargin: '200px' } );

	customElements.define( 'qr-chart', class extends HTMLElement {
		connectedCallback() {
			if ( src ) {
				near.observe( this );
			}
		}

		disconnectedCallback() {
			near.unobserve( this );
		}

		async draw() {
			const box = this.querySelector( '.chart' );
			const rows = [ ...this.querySelectorAll( 'tbody tr[data-year]' ) ];
			const names = [ ...this.querySelectorAll( 'thead th' ) ].slice( 1 )
				.map( ( th ) => th.textContent.trim() );
			// A line goes through one value of each year; the other values of
			// a year (other sources) are marks off the line.
			const lines = names.map( ( name, i ) => {
				const cells = rows.map( ( row ) => [ Number( row.dataset.year ), row.cells[ i + 1 ] ] );
				return {
					name,
					points: cells.filter( ( [ , td ] ) => td && 'amount' in td.dataset )
						.map( ( [ y, td ] ) => [ y, Number( td.dataset.amount ) ] ),
					others: cells.flatMap( ( [ y, td ] ) => td ?
						[ ...td.querySelectorAll( '[data-other]' ) ].map( ( o ) => [ y, Number( o.dataset.other ) ] ) :
						[] )
				};
			} );
			const otherNote = this.querySelector( '[data-other] .note' )?.textContent ?? '';
			if ( !box || !lines.some( ( l ) => l.points.length ) ) {
				return;
			}
			let lib;
			try {
				lib = await echarts();
			} catch ( e ) {
				return; // The table stays.
			}
			let year, exact, short;
			try {
				year = new Intl.NumberFormat( locale, { useGrouping: false } );
				exact = new Intl.NumberFormat( locale, { maximumFractionDigits: 20 } );
				short = new Intl.NumberFormat( locale, { notation: 'compact', maximumSignificantDigits: 4 } );
			} catch ( e ) {
				return;
			}
			const style = getComputedStyle( this );
			const token = ( name ) => style.getPropertyValue( name ).trim();
			const subtle = token( '--color-subtle' );
			const rtl = getComputedStyle( box ).direction === 'rtl';
			const single = lines.length === 1;
			// One line: the colour of the dimension. Lines of a split: the
			// colours of the parts, as in their key.
			const colour = ( i ) => token( single ? '--ink' : `--part-${ i + 1 }` );
			const years = [ ...new Set( lines.flatMap( ( l ) => l.points.map( ( [ y ] ) => y ) ) ) ]
				.sort( ( a, b ) => a - b );
			const few = years.length <= 6;
			const html = lib.format.encodeHTML;
			const pad = ( min, max ) => Math.max( 0.5, ( max - min ) * 0.1 );

			const plot = document.createElement( 'div' );
			plot.className = 'plot';
			plot.setAttribute( 'aria-hidden', 'true' );
			// The options turn the chart for a right-to-left page; the SVG
			// text must not turn again by the page direction.
			plot.dir = 'ltr';
			box.append( plot );
			const chart = lib.init( plot, null, { renderer: 'svg' } );
			chart.setOption( {
				animation: false,
				textStyle: { fontFamily: style.fontFamily },
				grid: { left: 8, right: 16, top: 24, bottom: 8, containLabel: true },
				tooltip: {
					trigger: 'axis',
					// Each series gives its nearest point: only the values of
					// the year of a line's point. Series 2i is line i, 2i + 1
					// its other values.
					formatter: ( params ) => {
						const at = ( params.find( ( p ) => p.seriesIndex % 2 === 0 ) ?? params[ 0 ] ).value[ 0 ];
						const value = ( p ) => exact.format( p.value[ 1 ] ) +
							( p.seriesIndex % 2 ? ` (${ html( otherNote ) })` : '' );
						const of = params.filter( ( p ) => p.value[ 0 ] === at );
						if ( single ) {
							return `${ year.format( at ) }: ${ of.map( value ).join( ' · ' ) }`;
						}
						return [ year.format( at ), ...of.map( ( p ) =>
							`${ p.marker }${ html( p.seriesName ) }: ${ value( p ) }` ) ].join( '<br>' );
					}
				},
				xAxis: {
					type: 'value',
					inverse: rtl,
					// Room at each end for the end points and their numbers.
					min: ( { min, max } ) => min - pad( min, max ),
					max: ( { min, max } ) => max + pad( min, max ),
					minInterval: 1,
					splitLine: { show: false },
					axisLine: { lineStyle: { color: token( '--border-color-base' ) } },
					// A few points: each year of the data has its label.
					axisTick: few ? { customValues: years } : {},
					axisLabel: {
						color: subtle,
						hideOverlap: true,
						...( few ? { customValues: years } : {} ),
						formatter: ( v ) => Number.isInteger( v ) ? year.format( v ) : ''
					}
				},
				yAxis: {
					type: 'value',
					position: rtl ? 'right' : 'left',
					scale: true,
					splitLine: { lineStyle: { color: token( '--border-color-subtle' ) } },
					axisLabel: { color: subtle, formatter: ( v ) => short.format( v ) }
				},
				series: lines.flatMap( ( l, i ) => [ {
					type: 'line',
					name: l.name,
					data: l.points,
					color: colour( i ),
					symbolSize: 6,
					showSymbol: l.points.length <= 24,
					label: {
						// The numbers on the points of one short line; with
						// lines, they would cover each other.
						show: single && few,
						color: subtle,
						formatter: ( p ) => short.format( p.value[ 1 ] )
					}
				}, {
					type: 'scatter',
					name: l.name,
					data: l.others,
					color: colour( i ),
					symbol: 'emptyCircle',
					symbolSize: 7
				} ] )
			} );
			this.classList.add( 'drawn' );
			new ResizeObserver( () => chart.resize() ).observe( box );
		}
	} );
}
</script>
</body>
</html>
