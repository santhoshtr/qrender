        </header>
        <div class="dialog-body"><div class="idlist"><div><span>archINFORM location ID</span><span>8464</span></div><div><span>BabelNet ID</span><span>00015561n</span></div><div><span>BBC News topic ID</span><span>cq26565v4d9t</span></div><div><span>BBC Things ID</span><span>bfe2de9d-fde7-4781-89ca-1735ede10982</span></div><div><span>Bibliothèque nationale de France ID</span><span>118650453</span></div><div><span>BlackPast.org ID</span><span>global-african-history/nairobi-kenya</span></div><div><span>Canadiana Name Authority ID</span><span>ncf10290894</span></div><div><span>CERL Thesaurus ID</span><span>cnl00030086</span></div><div><span>Comic Vine ID</span><span>4020-61168</span></div><div><span>Curlie ID</span><span>Regional/Africa/Kenya/Localities/Nairobi/</span></div><div><span>Data Commons ID</span><span>wikidataId/Q3870</span></div><div><span>Daum Encyclopedia ID</span><span>b03n2669a</span></div><div><span>De Agostini ID</span><span>Nairobi</span></div><div><span>Dewey Decimal Classification</span><span>2--67625</span></div><div><span>Encyclopædia Britannica Online ID</span><span>place/Nairobi</span></div><div><span>Encyclopædia Universalis ID</span><span>nairobi</span></div><div><span>Facebook location ID</span><span>114751268540391</span></div><div><span>FactGrid item ID</span><span>Q449252</span></div><div><span>FAST ID</span><span>1204373</span></div><div><span>FIPS 10-4 (countries and regions)</span><span>KE05</span></div><div><span>France 24 topic ID (French)</span><span>nairobi</span></div><div><span>Freebase ID</span><span>/m/05d49</span></div><div><span>GeoNames ID</span><span>184745</span></div><div><span>Getty Thesaurus of Geographic Names ID</span><span>7001116</span></div><div><span>GitHub topic</span><span>nairobi</span></div><div><span>GND ID</span><span>4041172-2</span></div><div><span>GNS Unique Feature ID</span><span>-2258072</span></div><div><span>Golden ID (archived)</span><span>Nairobi-PJED</span></div><div><span>Google Maps Customer ID</span><span>17856493610344092236</span></div><div><span>Google News topics ID</span><span>CAAqIQgKIhtDQkFTRGdvSUwyMHZNRFZrTkRrU0FtcGhLQUFQAQ</span></div><div><span>Gran Enciclopèdia Catalana ID</span><span>nairobi-0</span></div><div><span>Gran Enciclopèdia Catalana ID (former scheme)</span><span>0045300</span></div><div><span>Great Norwegian Encyclopedia ID</span><span>Nairobi</span></div><div><span>Great Russian Encyclopedia Online ID (2017)</span><span>2246269</span></div><div><span>Gynopedia ID</span><span>Nairobi</span></div><div><span>Harper&#39;s tag</span><span>nairobi</span></div><div><span>HASC</span><span>KE.NB</span></div><div><span>IdRef ID</span><span>029153042</span></div><div><span>iNaturalist place ID</span><span>10957</span></div><div><span>Interlingual Index ID</span><span>i83637</span></div><div><span>ISNI</span><span>000000010791732X</span></div><div><span>ISO 3166-2 code</span><span>KE-110</span></div><div><span>J9U entity ID</span><span>987007552644805171</span></div><div><span>KBpedia ID</span><span>NairobiArea-Kenya</span></div><div><span>Le Figaro tag ID</span><span>Nairobi</span></div><div><span>Lex ID</span><span>Nairobi</span></div><div><span>Library of Congress Authorities ID</span><span>n79011090</span></div><div><span>museum-digital place ID</span><span>20868</span></div><div><span>MusicBrainz area ID</span><span>4cc373f3-8b60-400b-8aa3-6df3fe4ab8fb</span></div><div><span>National Historical Museums of Sweden ID</span><span>geo/24610d81-9de7-4a91-97fc-9bb4cf1b8c7e</span></div><div><span>National Library of Spain SpMaBN ID</span><span>XX453921</span></div><div><span>Naver Encyclopedia ID (pre-August 2026)</span><span>1074255</span></div><div><span>NDL Authority ID</span><span>00628843</span></div><div><span>NL CR AUT ID</span><span>ge432139</span></div><div><span>OmegaWiki Defined Meaning</span><span>457020</span></div><div><span>Online PWN Encyclopedia ID</span><span>3945429</span></div><div><span>OpenHistoricalMap relation ID</span><span>2862891</span></div><div><span>OpenStreetMap relation ID</span><span>9185096</span></div><div><span>OpenWeatherMap city ID</span><span>184745</span></div><div><span>Proleksis enciklopedija ID</span><span>38283</span></div><div><span>RKD thesaurus ID</span><span>15689</span></div><div><span>SBN place ID</span><span>TSAL000079</span></div><div><span>SNARC ID</span><span>Q1381</span></div><div><span>SVKKL authority ID</span><span>0423566-Nairobi-Kena</span></div><div><span>Treccani ID</span><span>nairobi</span></div><div><span>Treccani&#39;s Dizionario di Storia ID</span><span>nairobi</span></div><div><span>Treccani&#39;s Enciclopedia Italiana ID</span><span>nairobi</span></div><div><span>Tripadvisor ID</span><span>294207</span></div><div><span>U.S. National Archives Identifier</span><span>10044568</span></div><div><span>UK Parliament thesaurus ID</span><span>11803</span></div><div><span>UN/LOCODE</span><span>KENBO</span></div><div><span>VIAF cluster ID</span><span>264835402</span></div><div><span>Vikidia article ID</span><span>fr:Nairobi</span></div><div><span>Vikidia article ID</span><span>en:Nairobi</span></div><div><span>Vikidia article ID</span><span>it:Nairobi</span></div><div><span>Vikidia article ID</span><span>es:Nairobi</span></div><div><span>Who&#39;s on First ID</span><span>421174401</span></div><div><span>WikiKids ID</span><span>Nairobi</span></div><div><span>Wikisimpsons article ID</span><span>49149</span></div><div><span>WOEID</span><span>1528488</span></div><div><span>WordNet 3.1 Synset ID</span><span>08948355-n</span></div><div><span>WorldCat Entities ID</span><span>E39PBJccgHVhXJcjCxQ6cXJxDq</span></div><div><span>YSO ID</span><span>110125</span></div><div><span>‎Yale LUX ID</span><span>place/2594dec6-5ad7-4c29-9b82-864ef69905b3</span></div></div></div>
    </dialog>
