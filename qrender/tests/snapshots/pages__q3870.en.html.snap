     alt=""
     loading="lazy">
        </li>
        <li>
            <span class="text">
                <b><a href="https://www.wikidata.org/wiki/Q41087">Raleigh</a></b><button class="src"
        type="button"
        popovertarget="p23"
        aria-label="Sources"><svg aria-hidden="true" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"><path d="m15 10-2.78-2.78L9.44 10V1H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2z"/></svg></button><span id="p23" popover class="pop cites"><span class="cite" data-kind="web">
    <span class="head"><img class="favicon" src="https://favicons.toolforge.org/favicon?url=nairobi.go.ke" alt="" width="32" height="32" loading="lazy"><span class="title"><a href="https://nairobi.go.ke/nairobi-city-city-raleigh-north-carolina-ink-twining-agreement/" lang="en">Nairobi City and the city of Raleigh, North Carolina ink twining agreement</a></span><span class="host">nairobi.go.ke</span></span>
