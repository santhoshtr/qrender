        <div class="run"> <figure class="m k-drawing" style="--a:1.831">
        <a href="https://commons.wikimedia.org/wiki/File:One_Battle_After_Another_logo.svg">
            <img src="https://commons.wikimedia.org/wiki/Special:FilePath/One%20Battle%20After%20Another%20logo.svg?width=960"
                 srcset="https://commons.wikimedia.org/wiki/Special:FilePath/One%20Battle%20After%20Another%20logo.svg?width=330 330w, https://commons.wikimedia.org/wiki/Special:FilePath/One%20Battle%20After%20Another%20logo.svg?width=500 500w, https://commons.wikimedia.org/wiki/Special:FilePath/One%20Battle%20After%20Another%20logo.svg?width=960 960w, https://commons.wikimedia.org/wiki/Special:FilePath/One%20Battle%20After%20Another%20logo.svg?width=1280 1280w, https://commons.wikimedia.org/wiki/Special:FilePath/One%20Battle%20After%20Another%20logo.svg?width=1920 1920w" sizes="(max-width: 760px) 100vw, 40vw"
