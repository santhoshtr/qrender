                 srcset="https://commons.wikimedia.org/wiki/Special:FilePath/Paris%20Night.jpg?width=330 330w, https://commons.wikimedia.org/wiki/Special:FilePath/Paris%20Night.jpg?width=500 500w, https://commons.wikimedia.org/wiki/Special:FilePath/Paris%20Night.jpg?width=960 960w, https://commons.wikimedia.org/wiki/Special:FilePath/Paris%20Night.jpg?width=1280 1280w, https://commons.wikimedia.org/wiki/Special:FilePath/Paris%20Night.jpg?width=1920 1920w" sizes="100vw"
