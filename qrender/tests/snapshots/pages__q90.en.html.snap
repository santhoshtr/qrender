         data-spread="demography"
         data-dimension="measures"><h2><span class="title">demography</span></h2><div data-slot="hero">
        <div class="block scale box">
    <h3 class="i-puzzle">country: <a href="https://www.wikidata.org/wiki/Q142">France</a></h3>
    <div class="bars"><div class="bar self"><span class="name">population</span><span class="track"><span style="--f:0.030665"></span></span><span class="val"><data value="0.030665" data-f="percent">3.1 %</data></span></div><div class="bar self"><span class="name">area</span><span class="track"><span style="--f:0.000164"></span></span><span class="val"><data value="0.000164" data-f="percent">0.016 %</data></span></div></div>
</div>
    </div><div data-slot="stack">
        <qr-chart class="block series box"><h3 class="i-puzzle">tabular population
    <button class="info"
            type="button"
            popovertarget="p34"
            aria-label="Description">i</button><span id="p34" popover class="pop">same as population (P1082); used when there is data for many different points in time</span><span class="prov-none" title="—"></span>
    <a class="edit"
       href="https://www.wikidata.org/wiki/Q90#P4179"
       aria-label="Edit"><svg aria-hidden="true" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"><path d="m15.4.4 4.2 4.2-3.2 3.2-4.2-4.2zM10.8 5 15 9.2l-8.6 8.6-4.5 1.5-1.2-1.2 1.5-4.5z"/></svg></a>
    </h3>
<div class="chart">
    <div class="data">
        <table>
            <thead>
