            <section class="spread t-columns" id="physical"
             data-spread="physical"
             data-dimension="measures"><h2><span class="title">ഭൗതികഗുണങ്ങൾ</span></h2><div data-slot="hero">
        <div class="block scale">
    <h3><span class="fb-group"><span class="fb"
      lang="en">parent astronomical body</span><a class="add-label"
