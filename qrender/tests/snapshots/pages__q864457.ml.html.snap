            <section class="spread t-columns" id="more"
         data-spread="more"
         data-dimension="neutral"><dl class="sheet" data-slot="sheet"><div class="row r-value"><dt class="i-puzzle"><span class="fb-group"><span class="fb"
      lang="en">computational complexity</span><a class="add-label"
           href="https://www.wikidata.org/wiki/Special:SetLabel/P10374/ml"
           aria-label="Add a label in your language"><svg aria-hidden="true" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"><path d="m15.4.4 4.2 4.2-3.2 3.2-4.2-4.2zM10.8 5 15 9.2l-8.6 8.6-4.5 1.5-1.2-1.2 1.5-4.5z"/></svg></a></span></dt>
