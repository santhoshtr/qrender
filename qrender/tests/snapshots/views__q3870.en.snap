    {
      "id": "economy",
      "prose_links": [
        {
          "href": "https://en.wikipedia.org/wiki/Nairobi#Economy",
          "lang": "en",
          "text": "Economy"
        }
      ],
      "prose_text": {
        "href": "https://en.wikipedia.org/wiki/Nairobi#Economy",
        "html": "Nairobi is home to the <a href=\"https://en.wikipedia.org/wiki/Nairobi_Securities_Exchange\">Nairobi Securities Exchange</a> (NSE), one of Africa's largest <a href=\"https://en.wikipedia.org/wiki/Stock_exchange\">stock exchanges</a>. The NSE was officially recognised as an overseas stock exchange by the <a href=\"https://en.wikipedia.org/wiki/London_Stock_Exchange\">London Stock Exchange</a> in 1953. The exchange is Africa's fourth largest in terms of trading volumes, and fifth largest in terms of Market Capitalization as a percentage of GDP.<sup data-note=\"8\"></sup>",
        "lang": "en",
        "local": true,
        "title": "Economy"
      },
      "title": {
        "href": "https://www.wikidata.org/wiki/Q159810",
        "lang": "en",
        "text": "economy"
      }
    },
    {
      "id": "connections",
      "prose_links": [
        {
          "href": "https://en.wikipedia.org/wiki/Nairobi#Twin_towns_and_sister_cities",
          "lang": "en",
          "text": "Twin towns and sister cities"
        }
      ],
      "prose_text": {
        "href": "https://en.wikipedia.org/wiki/Nairobi#Twin_towns_and_sister_cities",
        "html": "Nairobi is <a href=\"https://en.wikipedia.org/wiki/Sister_city\">twinned</a> with:<sup data-note=\"9\"></sup>",
        "lang": "en",
        "local": true,
        "title": "Twin towns and sister cities"
      },
      "title": {
        "href": "https://www.wikidata.org/wiki/Q930933",
        "lang": "en",
        "text": "relation"
      }
    },
    {
      "id": "history",
      "prose_links": [
        {
          "href": "https://en.wikipedia.org/wiki/Nairobi#History",
          "lang": "en",
          "text": "History"
        }
      ],
      "prose_text": {
        "href": "https://en.wikipedia.org/wiki/Nairobi#History",
        "html": "The site of Nairobi was originally a swamp land occupied by a <a href=\"https://en.wikipedia.org/wiki/Pastoralism\">pastoralist</a> people, the <a href=\"https://en.wikipedia.org/wiki/Maasai_people\">Maasai</a>, the long-distance trader community, <a href=\"https://en.wikipedia.org/wiki/Kamba_people\">Akamba People</a>, as well as the <a href=\"https://en.wikipedia.org/wiki/Agriculturalist\">agriculturalist</a> <a href=\"https://en.wikipedia.org/wiki/Kikuyu_people\">Kikuyu people</a>.<sup data-note=\"10\"></sup> The name Nairobi comes from the <a href=\"https://en.wikipedia.org/wiki/Maasai_language\">Maasai</a> expression meaning 'cool waters'. referring to the cold water stream which flowed through the area.<sup data-note=\"11\"></sup> With the arrival of the <a href=\"https://en.wikipedia.org/wiki/Uganda_Railway\">Uganda Railway</a>, the site was identified by <a href=\"https://en.wikipedia.org/wiki/George_Whitehouse\">Sir George Whitehouse</a> for a store depot, shunting ground and camping ground for the <a href=\"https://en.wikipedia.org/wiki/Indians_in_Kenya\">Indian</a> labourers working on the railway.<sup data-note=\"12\"></sup><sup data-note=\"13\"></sup>",
        "lang": "en",
        "local": true,
        "title": "History"
      },
      "title": {
        "href": "https://www.wikidata.org/wiki/Q309",
        "lang": "en",
        "text": "history"
      }
    },
    {
      "id": "media",
      "prose_links": [
        {
          "href": "https://en.wikipedia.org/wiki/Nairobi#Culture",
          "lang": "en",
          "text": "Culture"
        }
      ],
      "prose_text": {
        "href": "https://en.wikipedia.org/wiki/Nairobi#Culture",
        "html": "Nairobi is diverse in African cultures. As a cosmopolitan African city, it hosts all the diverse tribes that make up Kenya, and hosts a large immigrant population from other African countries.<sup data-note=\"14\"></sup><sup data-note=\"15\"></sup><sup data-note=\"16\"></sup>",
        "lang": "en",
        "local": true,
        "title": "Culture"
      },
      "title": {
        "href": "https://www.wikidata.org/wiki/Q131765",
        "lang": "en",
        "text": "multimedia"
      }
    },
