        }
      ],
      "prose_text": {
        "href": "https://en.wikipedia.org/wiki/Nairobi#Culture",
        "html": "Nairobi is diverse in African cultures. As a cosmopolitan African city, it hosts all the diverse tribes that make up Kenya, and hosts a large immigrant population from other African countries.",
        "lang": "en",
        "local": true,
        "title": "Culture"
