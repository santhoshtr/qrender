      dir="ltr"
      data-locale="en"
      data-design="design/0.2">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kokkachal</title>
    <meta name="description" content="Hamlet in Kasaragod district, Kerala, India">
