            <section class="spread t-lead-beside"
             data-spread="government" data-dimension="people"><h2>സർക്കാർ</h2><div data-slot="hero">
        <div class="block succession">
    <h3><a href="https://www.wikidata.org/wiki/Q192711">ഇന്ത്യൻ പ്രധാനമന്ത്രി</a></h3>
<figure class="m k-photo"
