                             alt=""
                             loading="lazy"></span>
                <div class="what">
                    <span class="fb-group"><a href="https://www.wikidata.org/wiki/Q124728912"><span class="fb" lang="en">independence of India</span></a><a class="add-label"
           href="https://www.wikidata.org/wiki/Special:SetLabel/ml/Q124728912"
           aria-label="Add a label in your language">+</a></span><span class="prov-none" title="—"></span>
                        <a class="edit"
       href="https://www.wikidata.org/wiki/Q668#P793"
       aria-label="Edit">✎</a>
                    
