                <span class="when">1947 – 1975</span>
                <span class="pic">
                        <img class="k-photo"
                             src="https://commons.wikimedia.org/wiki/Special:FilePath/British%20Indian%20Empire%201909%20Imperial%20Gazetteer%20of%20India.jpg?width=240"
                             alt=""
                             loading="lazy"></span>
                <div class="what">
                    <span class="fb-group"><a href="https://www.wikidata.org/wiki/Q3519674"><span class="fb" lang="en">political integration of India</span></a><a class="add-label"
           href="https://www.wikidata.org/wiki/Special:SetLabel/ml/Q3519674"
           aria-label="Add a label in your language">+</a></span><span class="prov-none" title="—"></span>
                        <a class="edit"
       href="https://www.wikidata.org/wiki/Q668#P793"
       aria-label="Edit">✎</a>
                    
