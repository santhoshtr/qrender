    {
      "id": "location",
      "prose_links": [
        {
          "href": "https://en.wikipedia.org/wiki/Paris#Geography",
          "lang": "en",
          "text": "Geography"
        }
      ],
      "prose_text": {
        "href": "https://en.wikipedia.org/wiki/Paris#Geography",
        "html": "Paris is located in northern central France, in a north-bending arc of the river <a href=\"https://en.wikipedia.org/wiki/Seine\">Seine</a>, whose crest includes two islands, the <a href=\"https://en.wikipedia.org/wiki/%C3%8Ele_Saint-Louis\">Île Saint-Louis</a> and the larger <a href=\"https://en.wikipedia.org/wiki/%C3%8Ele_de_la_Cit%C3%A9\">Île de la Cité</a>, which form the oldest part of Paris. The river's mouth on the <a href=\"https://en.wikipedia.org/wiki/English_Channel\">English Channel</a> (<i>La Manche</i>) is about 233&#160;mi (375&#160;km) downstream from Paris. Paris is spread widely on both banks of the river. Overall, Paris is relatively flat, and the lowest point is 35&#160;m (115&#160;ft) <a href=\"https://en.wikipedia.org/wiki/Above_mean_sea_level\">above sea level</a>. Paris has several prominent hills, the highest of which is <a href=\"https://en.wikipedia.org/wiki/Montmartre\">Montmartre</a> at 130&#160;m (427&#160;ft).",
        "lang": "en",
        "local": true,
        "title": "Geography"
      },
      "title": {
        "href": "https://www.wikidata.org/wiki/Q1071",
