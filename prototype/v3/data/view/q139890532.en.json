    "fallback": false
   },
   "prose_text": {
    "html": "Kokkachal is situated along the rural routes connecting <a href=\"https://en.wikipedia.org/wiki/Bandiyod\">Bandiyod</a> (approximately 6.5&#160;km away) and Dharmathadukka. Geographically, it sits close to the border of the Puthige and Mangalpady local government jurisdictions. The landscape is characterized by the typical midland topography of Northern Malabar, with seasonal streams feeding into larger coastal river systems.",
    "lang": "en",
    "local": true,
    "title": "Geography",
    "href": "https://en.wikipedia.org/wiki/Kokkachal#Geography"
   },
